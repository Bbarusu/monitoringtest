<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MonitorPC</AssemblyName>
    <RootNamespace>MonitorPC</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    WPF e WinForms convivem no projeto: o WinForms so entra pelo icone da bandeja.
    Os using implicitos de System.Drawing e System.Windows.Forms colidiriam com
    System.Windows.Media em Color, Brush, Point, Size e Application, entao ficam
    de fora. Quem precisa deles usa o alias D. ou WF., declarado no arquivo.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
