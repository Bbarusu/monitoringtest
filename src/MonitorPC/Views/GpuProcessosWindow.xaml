<Window x:Class="MonitorPC.Views.GpuProcessosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPU por programa"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GPU por programa" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock x:Name="Subtitulo" FontSize="12" Margin="0,3,0,0"
                               TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <Grid Margin="2,20,2,6">
                <TextBlock Text="Programa" FontSize="11" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextoMuitoFraco}" />
                <TextBlock Text="Ocupação" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextoMuitoFraco}" />
            </Grid>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,4,6,4">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <StackPanel x:Name="Lista" Margin="0,0,6,0" />
                </ScrollViewer>
            </Border>

            <!-- Como ler os números -->
            <Border Margin="0,16,0,0" CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Como ler" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextoFraco}"
                               Text="A porcentagem é da parte mais ocupada da placa por aquele programa, e não a soma de todas — é assim que o Gerenciador de Tarefas também conta. 3D é desenho e jogo; Compute é cálculo, o que um minerador usaria; VideoDecode e VideoEncode são vídeo e chamadas." />
                    <TextBlock x:Name="Aviso" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource AlertaTexto}" />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource BotaoLargo}" Margin="0,16,0,0"
                    Content="Fechar" Click="Voltar_Click" />

            <TextBlock FontSize="11" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="Os números vêm dos contadores do Windows, não de um sensor da placa: é o agendador gráfico que sabe repartir o uso por programa." />

        </StackPanel>
    </Border>
</Window>
