<Window x:Class="MonitorPC.Views.DesempenhoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modo Desempenho"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,-14,0">
        <StackPanel Margin="0,0,14,0">

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Modo Desempenho" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock Text="Libera recursos para jogos e tarefas pesadas" FontSize="12"
                               Margin="0,3,0,0" Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="O que fazer" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left">
                        <TextBlock Text="Trocar para o plano Desempenho" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock Text="Plano de energia do Windows" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="TrocarPlano" Style="{StaticResource Interruptor}" IsChecked="True"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left">
                        <TextBlock Text="Limpar arquivos temporários" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock x:Name="DetalheTemporarios" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"
                                   Text="Calculando…" />
                    </StackPanel>
                    <CheckBox x:Name="LimparTemp" Style="{StaticResource Interruptor}" IsChecked="True"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left">
                        <TextBlock Text="Fechar programas abertos" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock x:Name="DetalheProcessos" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"
                                   Text="Nenhum selecionado abaixo" />
                    </StackPanel>
                    <CheckBox x:Name="FecharProcessos" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="FecharProcessos_Alterado" Unchecked="FecharProcessos_Alterado" />
                </Grid>
            </Border>

            <StackPanel x:Name="AreaProcessos" Visibility="Collapsed">
                <Grid Margin="0,16,0,8">
                    <TextBlock Text="Escolha o que fechar" FontSize="11" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextoFraco}" />
                    <TextBlock x:Name="TotalSelecionado" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextoFraco}" />
                </Grid>
                <StackPanel x:Name="ListaProcessos" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextoMuitoFraco}"
                           Text="Encerra o programa. Vale a ressalva: antivírus, drivers essenciais e processos do Windows não são exibidos aqui." />
            </StackPanel>

            <Button x:Name="BotaoAtivar" Style="{StaticResource BotaoLargo}" Height="48"
                    Margin="0,20,0,0" Click="Ativar_Click">
                <TextBlock Text="Ativar Modo Desempenho" FontSize="14" FontWeight="SemiBold" />
            </Button>

            <TextBlock x:Name="Resultado" FontSize="11" Margin="0,8,0,0" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="O plano de energia volta ao equilibrado." />

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
