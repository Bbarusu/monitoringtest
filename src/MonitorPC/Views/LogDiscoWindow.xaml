<Window x:Class="MonitorPC.Views.LogDiscoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log de disco"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!-- Cabecalho -->
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Log de disco" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Subtitulo" FontSize="12" Margin="0,3,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <ComboBox x:Name="SeletorDisco" Style="{StaticResource Seletor}"
                                  Margin="10,3,0,0" MaxWidth="130"
                                  SelectionChanged="SeletorDisco_Alterado" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Filtros -->
            <Border Margin="0,20,0,0" CornerRadius="14" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="4">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="FiltroTodos" Style="{StaticResource Aba}" Content="Todos"
                                 IsChecked="True" Checked="Filtro_Alterado" />
                    <RadioButton x:Name="FiltroLeitura" Style="{StaticResource Aba}" Content="Leitura"
                                 Checked="Filtro_Alterado" />
                    <RadioButton x:Name="FiltroEscrita" Style="{StaticResource Aba}" Content="Escrita"
                                 Checked="Filtro_Alterado" />
                    <RadioButton x:Name="FiltroAltos" Style="{StaticResource Aba}" Content="Altos"
                                 Checked="Filtro_Alterado" />
                </UniformGrid>
            </Border>

            <!-- Lista -->
            <Border Margin="0,16,0,0" MinHeight="260" CornerRadius="12"
                    Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1" Padding="12,4">
                <Grid>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Lista" />
                    </ScrollViewer>
                    <TextBlock x:Name="Vazio" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="12"
                               Foreground="{DynamicResource TextoMuitoFraco}" />
                </Grid>
            </Border>

            <!-- Limite de registro -->
            <Border Margin="0,16,0,0" CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Registrar quando passar de" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock Text="Por processo, somando leitura e escrita" FontSize="11"
                                       Margin="0,2,0,0" Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <TextBlock x:Name="ValorLimite" FontSize="28" FontWeight="Light"
                                   FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="Limite" IsMoveToPointEnabled="True" Minimum="1" Maximum="100"
                            Margin="0,10,0,0" IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{DynamicResource Acento}" ValueChanged="Limite_Alterado" />
                </StackPanel>
            </Border>

            <!-- Rastreamento avancado -->
            <Border Margin="0,10,0,0" CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="M6,3 L15,3 L19,7 L19,21 L6,21 Z M9,12 L16,12 M9,16 L16,16"
                          Stroke="{DynamicResource IconeFraco}" StrokeThickness="1.8" StrokeLineJoin="Round"
                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top"
                          Margin="0,2,10,0" />
                    <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextoMuitoFraco}"
                               Text="Clique em um evento da lista para ver os arquivos que aquele processo tem abertos agora." />
                </Grid>
            </Border>

            <!-- Acoes -->
            <Button Style="{StaticResource BotaoLargo}" Margin="0,16,0,0"
                    Content="Limpar log" Click="Limpar_Click" />

            <TextBlock x:Name="Rodape" FontSize="11" Margin="0,8,0,0" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="O registro corre enquanto esta tela estiver aberta." />

        </StackPanel>
    </Border>
</Window>
