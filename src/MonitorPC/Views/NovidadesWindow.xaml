<Window x:Class="MonitorPC.Views.NovidadesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novidades do KInfo"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <!--
        Novidades: o Kdrop inteiro, em seis passos, no mesmo formato do guia
        da Kisland (prévia desenhada em cima, texto embaixo). Abre sozinho uma
        vez para todos (App.VersaoDasNovidades), sem o "Pular", e fica na
        Personalização para rever.
    -->

    <Window.Resources>
        <Style x:Key="TituloPasso" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="Margin" Value="0,18,0,0" />
        </Style>
        <Style x:Key="TextoPasso" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Icone}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Mesa" TargetType="Border">
            <Setter Property="Height" Value="160" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#0C0D10" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- A bandeja da Kisland, menor, para as prévias. -->
        <Style x:Key="BandejaPrevia" TargetType="Border">
            <Setter Property="Width" Value="400" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource Cartao}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Destaque" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource InfoFundo}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Quadrado" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Chip}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Desenho" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Icone}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BotaoFalso" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource Chip}" />
        </Style>
        <Style x:Key="BotaoPrincipalGuia" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12" Background="{DynamicResource Acento}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinhaItem" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource Cartao}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border x:Name="Painel" Margin="20" CornerRadius="16" Padding="22"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1"
            MouseLeftButtonDown="Painel_Arrastar">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.36" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!-- Cabeçalho -->
            <Grid>
                <TextBlock x:Name="Contagem" Text="Novidades · 1 de 6" FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextoFraco}" />
                <Button x:Name="BotaoPular" HorizontalAlignment="Right" Cursor="Hand" Click="Pular_Click" ToolTip="Fechar"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="10" Padding="12,7" Background="Transparent">
                                <TextBlock Text="Pular" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Cartao}" />
                                </Trigger>
                                <!-- Obrigatório: o "Pular" fica apagado e não responde. -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Background" Value="Transparent" />
                                    <Setter TargetName="bg" Property="Opacity" Value="0.35" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Os passos ocupam a mesma altura, para os botões não pularem. -->
            <Grid Height="430" Margin="0,16,0,0">

                <!-- ===================== 1. O QUE É ===================== -->
                <StackPanel x:Name="Passo1">
                    <Border Style="{StaticResource Mesa}">
                        <Border Style="{StaticResource BandejaPrevia}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,15 L12,3 M7,8 L12,3 L17,8 M4,14 L4,18 A2,2 0 0,0 6,20 L18,20 A2,2 0 0,0 20,18 L20,14"
                                          Stroke="{DynamicResource Acento}" StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Kdrop" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                    <TextBlock Text="· toque para mandar a bandeja" Style="{StaticResource Rotulo}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <StackPanel Width="90">
                                        <Grid Width="48" Height="48">
                                            <Ellipse Fill="{DynamicResource Chip}" />
                                            <Path Style="{StaticResource Desenho}" Width="20" Height="20"
                                                  Data="M4,5 L20,5 L20,16 L4,16 Z M9,20 L15,20 M12,16 L12,20" />
                                            <Ellipse Width="12" Height="12" Fill="#22C55E" Stroke="{DynamicResource Cartao}" StrokeThickness="2"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <TextBlock Text="PC da sala" FontSize="11" FontWeight="Medium" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                    </StackPanel>
                                    <StackPanel Width="90">
                                        <Grid Width="48" Height="48">
                                            <Ellipse Fill="{DynamicResource Chip}" Stroke="{DynamicResource Acento}" StrokeThickness="2" />
                                            <Path Style="{StaticResource Desenho}" Width="20" Height="20"
                                                  Data="M8,2 L16,2 A2,2 0 0,1 18,4 L18,20 A2,2 0 0,1 16,22 L8,22 A2,2 0 0,1 6,20 L6,4 A2,2 0 0,1 8,2 Z M11,18 L13,18" />
                                            <Ellipse Width="12" Height="12" Fill="#22C55E" Stroke="{DynamicResource Cartao}" StrokeThickness="2"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <TextBlock Text="iPhone" FontSize="11" FontWeight="Medium" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                    </StackPanel>
                                    <StackPanel Width="90">
                                        <Grid Width="48" Height="48">
                                            <Ellipse Fill="{DynamicResource Chip}" />
                                            <Path Style="{StaticResource Desenho}" Width="20" Height="20"
                                                  Data="M5,6 L19,6 L19,15 L5,15 Z M3,18 L21,18" />
                                            <Ellipse Width="12" Height="12" Fill="#22C55E" Stroke="{DynamicResource Cartao}" StrokeThickness="2"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <TextBlock Text="Notebook" FontSize="11" FontWeight="Medium" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Conheça o Kdrop" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="O Kdrop transforma a bandeja da Kisland numa ponte entre os aparelhos da sua casa: celulares e outros PCs com KInfo, no mesmo Wi-Fi. Fotos, vídeos, arquivos, textos e links vão e voltam sem cabo, sem nuvem e sem instalar nada no celular." />
                    <Border Style="{StaticResource LinhaItem}" Margin="0,16,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                                <TextBlock Text="Ligar o Kdrop" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DetalheKdrop" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}"
                                           Text="Liga a Kisland e a bandeja junto, se estiverem desligadas." />
                            </StackPanel>
                            <CheckBox x:Name="ItemKdrop" Style="{StaticResource Interruptor}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Kdrop_Alterado" Unchecked="Kdrop_Alterado" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ================ 2. ENDEREÇO FIXO NO CELULAR ================ -->
                <StackPanel x:Name="Passo2" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <!-- O celular, com a página do Kdrop e a dica do endereço fixo. -->
                        <Border Width="230" Height="190" Margin="0,14,0,0" CornerRadius="22" Padding="12,14,12,0"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Background="{DynamicResource Fundo}" BorderBrush="{DynamicResource Trilho}" BorderThickness="2">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Chip}">
                                        <Path Style="{StaticResource Desenho}" Width="13" Height="13" Stroke="{DynamicResource Acento}"
                                              Data="M4,13 L7,5 L17,5 L20,13 L20,18 A2,2 0 0,1 18,20 L6,20 A2,2 0 0,1 4,18 Z M4,13 L9,13 L10,15 L14,15 L15,13 L20,13" />
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Kdrop · bandeja do" FontSize="9" Foreground="{DynamicResource TextoFraco}" />
                                        <TextBlock x:Name="NomeDoPcPrevia" Text="Desktop" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" Foreground="{DynamicResource Texto}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Style="{StaticResource Destaque}" Margin="0,10,0,0" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Endereço fixo deste PC" FontSize="9.5" Foreground="{DynamicResource InfoTexto}" />
                                        <TextBlock x:Name="EnderecoPrevia" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Texto}" />
                                        <TextBlock Text="Salve nos favoritos ou na Tela de Início" FontSize="9.5" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Icone}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Seu celular, sem QR Code" />
                    <TextBlock Style="{StaticResource TextoPasso}">
                        Leia o QR Code uma vez (na Kisland, toque em <Run FontWeight="SemiBold" Text="Celular" />). A página do Kdrop mostra o endereço fixo deste PC: abra por ele e salve nos favoritos, ou toque em <Run FontWeight="SemiBold" Text="Compartilhar › Adicionar à Tela de Início" />. Daí em diante é só abrir, mesmo que o roteador troque o IP do PC.
                    </TextBlock>
                    <Border Style="{StaticResource LinhaItem}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="O endereço fixo deste PC" FontSize="11" Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="EnderecoFixo" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Acento}" />
                            <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"
                                       Text="Ele segue o nome do Kdrop, que dá para trocar na Personalização." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============== 3. FOTOS, VÍDEOS E ARQUIVOS ============== -->
                <StackPanel x:Name="Passo3" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Border Style="{StaticResource BandejaPrevia}">
                            <Border Style="{StaticResource Destaque}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Chip}">
                                            <Path Style="{StaticResource Desenho}"
                                                  Data="M8,2 L16,2 A2,2 0 0,1 18,4 L18,20 A2,2 0 0,1 16,22 L8,22 A2,2 0 0,1 6,20 L6,4 A2,2 0 0,1 8,2 Z M11,18 L13,18" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Kdrop" FontSize="10" Foreground="{DynamicResource InfoTexto}" />
                                            <TextBlock Text="iPhone quer colocar 3 arquivos na sua bandeja" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Texto}" />
                                            <TextBlock Text="Foto 2026-11-05.jpg, Vídeo.mov e mais 1 · 184 MB" FontSize="10.5"
                                                       Foreground="{DynamicResource TextoFraco}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <UniformGrid Columns="2" Margin="0,10,0,0">
                                        <Border Style="{StaticResource BotaoFalso}" Margin="0,0,5,0" Background="{DynamicResource Cartao}">
                                            <TextBlock Text="Recusar" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                        </Border>
                                        <Border Style="{StaticResource BotaoFalso}" Margin="5,0,0,0" Background="{DynamicResource Acento}">
                                            <TextBlock Text="Aceitar" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="White" />
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Fotos, vídeos e arquivos" />
                    <TextBlock Style="{StaticResource TextoPasso}">
                        No celular, toque em <Run FontWeight="SemiBold" Text="Escolher fotos e arquivos" /> e mande. A Kisland abre e pergunta antes de aceitar qualquer coisa; marque <Run FontWeight="SemiBold" Text="Aceitar sozinho deste aparelho" /> nos seus e eles não perguntam mais. O que chega vai para Downloads › Kdrop e para a bandeja. Vídeos grandes também vão: se o Wi-Fi oscilar, o envio continua de onde parou.
                    </TextBlock>
                </StackPanel>

                <!-- ================== 4. TEXTOS E LINKS ================== -->
                <StackPanel x:Name="Passo4" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Border Style="{StaticResource BandejaPrevia}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Bandeja · 3 itens" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Texto}" />
                                    <Border HorizontalAlignment="Right" Height="26" CornerRadius="13" Padding="10,0"
                                            Background="{DynamicResource Chip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Desenho}" Width="11" Height="11"
                                                  Data="M9,4 L15,4 L15,7 L9,7 Z M7,5 L5,5 L5,21 L19,21 L19,5 L17,5" />
                                            <TextBlock Text="Colar texto" FontSize="10.5" FontWeight="Medium" Margin="5,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Icone}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Destaque}" Margin="0,8,0,0" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Quadrado}" CornerRadius="18" Width="32" Height="32">
                                            <Path Style="{StaticResource Desenho}" Width="14" Height="14"
                                                  Data="M10,14 A4,4 0 0,0 15.7,14 L18.7,11 A4,4 0 0,0 13,5.3 L12,6.3 M14,10 A4,4 0 0,0 8.3,10 L5.3,13 A4,4 0 0,0 11,18.7 L12,17.7" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Link do iPhone · Kdrop" FontSize="9.5" Foreground="{DynamicResource InfoTexto}" />
                                            <TextBlock Text="youtube.com/watch?v=…" FontSize="11.5" FontWeight="Medium"
                                                       Foreground="{DynamicResource Texto}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource BotaoFalso}" Height="26" Background="{DynamicResource Cartao}">
                                                <TextBlock Text="Copiar" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Texto}" />
                                            </Border>
                                            <Border Style="{StaticResource BotaoFalso}" Height="26" Margin="6,0,0,0" Background="{DynamicResource Acento}">
                                                <TextBlock Text="Abrir link" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Textos e links, nos dois sentidos" />
                    <TextBlock Style="{StaticResource TextoPasso}">
                        Do celular: escreva ou cole em <Run FontWeight="SemiBold" Text="Mandar texto ou link" />. Chega na Kisland com <Run FontWeight="SemiBold" Text="Copiar" /> e, se for link, <Run FontWeight="SemiBold" Text="Abrir" />. Do PC: copie qualquer texto e toque em <Run FontWeight="SemiBold" Text="Colar texto" /> na bandeja. Ele aparece no celular, pronto para copiar. Na bandeja, um toque no texto copia de novo, e no link abre.
                    </TextBlock>
                </StackPanel>

                <!-- ================ 5. ENTRE OS PCS DA CASA ================ -->
                <StackPanel x:Name="Passo5" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Border Style="{StaticResource BandejaPrevia}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextoFraco}">
                                    <Run FontWeight="Medium" Text="Na bandeja de Notebook" /> · toque para trazer
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <StackPanel Width="70">
                                        <Border Style="{StaticResource Quadrado}" Width="40" Height="40" Margin="0" CornerRadius="12">
                                            <Path Style="{StaticResource Desenho}" Data="M6,3 L14,3 L19,8 L19,19 A2,2 0 0,1 17,21 L7,21 A2,2 0 0,1 5,19 L5,4 A1,1 0 0,1 6,3 Z M14,3 L14,8 L19,8" />
                                        </Border>
                                        <TextBlock Text="Planilha.xlsx" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="64" Foreground="{DynamicResource TextoFraco}" />
                                    </StackPanel>
                                    <StackPanel Width="70">
                                        <Border Style="{StaticResource Quadrado}" Width="40" Height="40" Margin="0" CornerRadius="12">
                                            <Path Style="{StaticResource Desenho}" Data="M3,7 A2,2 0 0,1 5,5 L9,5 L11,7 L19,7 A2,2 0 0,1 21,9 L21,18 A2,2 0 0,1 19,20 L5,20 A2,2 0 0,1 3,18 Z" />
                                        </Border>
                                        <TextBlock Text="Fotos da viagem" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="64" Foreground="{DynamicResource TextoFraco}" />
                                    </StackPanel>
                                    <StackPanel Width="70">
                                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Chip}"
                                                BorderBrush="{DynamicResource Acento}" BorderThickness="1">
                                            <Path Style="{StaticResource Desenho}" Stroke="{DynamicResource Acento}"
                                                  Data="M4,7 L4,5 L16,5 L16,7 M10,5 L10,19 M8,19 L12,19 M14,12 L20,12 M17,12 L17,19" />
                                        </Border>
                                        <TextBlock Text="Senha do Wi-Fi" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="64" Foreground="{DynamicResource TextoFraco}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Entre os PCs da casa" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Cada PC com KInfo e Kdrop ligado mostra a bandeja dele na Kisland dos outros. Um toque traz o arquivo para este PC, sem pedir aceite: quem pôs na bandeja já deixou à vista. Pastas vêm compactadas e chegam abertas; no celular, baixam como .zip. Textos chegam já copiados." />
                </StackPanel>

                <!-- ================== 6. ARRASTE E SOLTE ================== -->
                <StackPanel x:Name="Passo6" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Grid>
                            <Border Width="180" Height="44" CornerRadius="22" Margin="0,14,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Background="{DynamicResource Fundo}" BorderBrush="{DynamicResource Acento}" BorderThickness="1.5">
                                <TextBlock Text="Solte aqui para deixar na bandeja" FontSize="10.5" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource InfoTexto}" />
                            </Border>
                            <!-- Um arquivo vindo do Explorer, com a seta do arrasto. -->
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,18">
                                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Chip}"
                                        BorderBrush="{DynamicResource Trilho}" BorderThickness="1">
                                    <Path Style="{StaticResource Desenho}" Width="18" Height="18"
                                          Data="M6,3 L14,3 L19,8 L19,19 A2,2 0 0,1 17,21 L7,21 A2,2 0 0,1 5,19 L5,4 A1,1 0 0,1 6,3 Z M14,3 L14,8 L19,8" />
                                </Border>
                                <TextBlock Text="Relatório.pdf" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <Path Data="M175,108 C200,80 230,70 255,64" Stroke="{DynamicResource Acento}" StrokeThickness="1.6"
                                  StrokeDashArray="3,3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M248,58 L256,64 L247,69" Stroke="{DynamicResource Acento}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Arraste e solte" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Arraste arquivos do Explorer até a Kisland: ela abre sozinha e eles ficam na bandeja, já à vista dos outros aparelhos. Dentro dela, arraste um item até um aparelho para mandar só ele, ou toque no aparelho para mandar a bandeja inteira. Arrastado para fora, o item vai para uma pasta, um e-mail ou um chat." />
                    <TextBlock Style="{StaticResource TextoPasso}" Margin="0,12,0,0" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               Text="Dá para rever estas novidades quando quiser em Personalização › Kisland." />
                </StackPanel>
            </Grid>

            <!-- Rodapé -->
            <Grid Margin="0,18,0,0">
                <StackPanel x:Name="Pontos" Orientation="Horizontal" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BotaoVoltar" Style="{StaticResource BotaoLargo}" Width="96" Margin="0,0,8,0"
                            Content="Voltar" Click="Voltar_Click" />
                    <Button x:Name="BotaoAvancar" Style="{StaticResource BotaoPrincipalGuia}" MinWidth="110"
                            Content="Próximo" Click="Avancar_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
