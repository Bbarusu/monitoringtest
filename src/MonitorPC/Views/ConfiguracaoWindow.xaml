<Window x:Class="MonitorPC.Views.ConfiguracaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!-- Cabecalho -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BotaoVoltar" Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Titulo" Text="Configuração inicial" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock x:Name="Subtitulo" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                               MaxWidth="320" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextoFraco}"
                               Text="Defina o limite de temperatura de cada componente. Avisamos quando algum for ultrapassado." />
                </StackPanel>
            </StackPanel>

            <!--
                O miolo rola: com a lista de ventoinhas aberta, a tela passa de
                900 px e nao cabe num notebook.
            -->
            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
              <StackPanel>

            <!-- Limites -->
            <TextBlock Text="Limites de temperatura" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock x:Name="AgoraCpu" Text="agora --" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <TextBlock x:Name="ValorCpu" Text="75 °C" FontSize="28" FontWeight="Light"
                                   FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="LimiteCpu" IsMoveToPointEnabled="True" Minimum="30" Maximum="100" Margin="0,10,0,0"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{DynamicResource Acento}" ValueChanged="Limite_Alterado" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="30 °C" FontSize="11" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                        <TextBlock Text="Sugerido: 75 °C" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                        <TextBlock Text="100 °C" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GPU" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock x:Name="AgoraGpu" Text="agora --" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <TextBlock x:Name="ValorGpu" Text="80 °C" FontSize="28" FontWeight="Light"
                                   FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="LimiteGpu" IsMoveToPointEnabled="True" Minimum="30" Maximum="110" Margin="0,10,0,0"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{DynamicResource Acento}" ValueChanged="Limite_Alterado" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="30 °C" FontSize="11" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                        <TextBlock Text="Sugerido: 80 °C" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                        <TextBlock Text="110 °C" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Disco" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock x:Name="AgoraDisco" Text="agora --" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <TextBlock x:Name="ValorDisco" Text="55 °C" FontSize="28" FontWeight="Light"
                                   FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="LimiteDisco" IsMoveToPointEnabled="True" Minimum="30" Maximum="80" Margin="0,10,0,0"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{DynamicResource Acento}" ValueChanged="Limite_Alterado" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="30 °C" FontSize="11" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                        <TextBlock Text="Sugerido: 55 °C" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                        <TextBlock Text="80 °C" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ao ultrapassar -->
            <TextBlock Text="Ao ultrapassar" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Notificação do Windows" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock Text="Aviso na tela mesmo com o painel fechado" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="Notificar" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sugerir Modo Econômico" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock Text="Oferece reduzir o consumo no próprio aviso" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="SugerirEconomico" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- No painel -->
            <TextBlock Text="No painel" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" MaxWidth="300"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Ventoinhas" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock Text="Visualizar rotação em tempo real" FontSize="11"
                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <CheckBox x:Name="MostrarVentoinhas" Style="{StaticResource Interruptor}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="MostrarVentoinhas_Alterado"
                                  Unchecked="MostrarVentoinhas_Alterado" />
                    </Grid>

                    <!--
                        A escolha de quais ventoinhas so faz sentido com a chave
                        ligada, entao ela aparece junto. A rotacao de cada uma
                        atualiza aqui dentro: "Fan #3" nao diz nada, mas o numero
                        que muda quando o usuario encosta a mao na ventoinha diz.
                    -->
                    <StackPanel x:Name="BlocoVentoinhas" Visibility="Collapsed" Margin="0,12,0,0">
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <TextBlock x:Name="AjudaVentoinhas" FontSize="11" Margin="0,10,0,6"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ListaVentoinhas" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

              </StackPanel>
            </ScrollViewer>

            <Button x:Name="BotaoConcluir" Style="{StaticResource BotaoLargo}" Height="48"
                    Margin="0,20,0,0" Click="Concluir_Click">
                <TextBlock x:Name="TextoConcluir" Text="Concluir configuração" FontSize="14"
                           FontWeight="SemiBold" />
            </Button>

            <TextBlock x:Name="Rodape" FontSize="11" Margin="0,8,0,0" TextAlignment="Center"
                       Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="Você pode mudar os limites depois, pelo ícone de ajustes." />

        </StackPanel>
    </Border>
</Window>
