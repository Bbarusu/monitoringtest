<Window x:Class="MonitorPC.Views.EstresseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teste de estresse"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <!--
            Rolagem para tela baixa. Esta janela cresce com o conteúdo, e num
            notebook o conteúdo passa da altura útil; Janelas.LimitarAltura põe
            o teto, e sem rolagem o teto cortaria em vez de passar da tela —
            troca de um problema por outro. Aqui o conteúdo rola inteiro,
            botões incluídos: são poucas linhas e todas alcançáveis.
        -->
        <!-- A barra de rolagem fica na margem interna do painel, com 6 px de
             folga do conteúdo e da borda: o conteúdo tem a mesma largura com
             ou sem barra, e ela não encosta em nada. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,-14,0">
        <StackPanel Margin="0,0,14,0">

            <!-- Cabecalho -->
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Teste de estresse" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock Text="Carga de CPU controlada, com parada automática"
                               FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <!-- Leitura ao vivo -->
            <Border Margin="0,20,0,0" CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="14">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="Estado" Text="Pronto" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock x:Name="Tempo" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TempAgora" Text="--" FontSize="34" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}" />
                            <TextBlock Text="°C" FontSize="14" Margin="3,10,0,0"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Uso" FontSize="11"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="UsoAgora" Text="--" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,2,0,0" Foreground="{DynamicResource Texto}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Clock" FontSize="11"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="ClockAgora" Text="--" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,2,0,0" Foreground="{DynamicResource Texto}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Potência" FontSize="11"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="WattsAgora" Text="--" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,2,0,0" Foreground="{DynamicResource Texto}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Ajustes -->
            <StackPanel x:Name="AreaAjustes" Margin="0,10,0,0">
                <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1"
                        Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Threads sob carga" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DetalheThreads" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <TextBlock x:Name="ValorThreads" FontSize="28" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="Threads" IsMoveToPointEnabled="True" Minimum="1" Margin="0,10,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Foreground="{DynamicResource Acento}" ValueChanged="Ajuste_Alterado" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Duração" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="O teste para sozinho ao fim do tempo" FontSize="11"
                                           Margin="0,2,0,0" Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <TextBlock x:Name="ValorDuracao" FontSize="28" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="Duracao" IsMoveToPointEnabled="True" Minimum="1" Maximum="15"
                                Value="3" Margin="0,10,0,0" IsSnapToTickEnabled="True" TickFrequency="1"
                                Foreground="{DynamicResource Acento}" ValueChanged="Ajuste_Alterado" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Aviso -->
            <Border Margin="0,10,0,0" CornerRadius="12" Background="{DynamicResource AvisoFundo}"
                    BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="M12,3 L22,21 L2,21 Z M12,10 L12,15 M12,18 L12,18.01"
                          Stroke="{DynamicResource AvisoIcone}" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top"
                          Margin="0,2,10,0" />
                    <TextBlock x:Name="TextoAviso" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource AlertaTexto}" />
                </Grid>
            </Border>

            <!-- Resultado -->
            <Border x:Name="AreaResultado" Visibility="Collapsed" Margin="0,10,0,0" CornerRadius="12"
                    Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1" Padding="14">
                <StackPanel x:Name="Resultado" />
            </Border>

            <Button x:Name="BotaoAcao" Style="{StaticResource BotaoLargo}" Height="48"
                    Margin="0,16,0,0" Click="Acao_Click">
                <TextBlock x:Name="TextoAcao" Text="Iniciar teste" FontSize="14" FontWeight="SemiBold" />
            </Button>

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
