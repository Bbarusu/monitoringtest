<Window x:Class="MonitorPC.Views.GuiaKislandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conhecendo a Kisland"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <!--
        O guia da Kisland: nove passos, cada um com uma prévia desenhada e o
        controle de verdade. O que se mexe aqui vale na hora — não é demonstração,
        é a própria configuração, então ninguém precisa repetir tudo depois na
        Personalização.
    -->

    <Window.Resources>
        <!-- Os mesmos estilos da Kisland de verdade (IlhaWindow.xaml), para a
             prévia ser a Kisland, e não um desenho parecido com ela. -->
        <Style x:Key="ChipGuia" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Chip}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Trilho}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TextoChipGuia" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="IconeChipGuia" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextoFraco}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BarraGuia" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Fill" Value="{DynamicResource Acento}" />
        </Style>
        <Style x:Key="TituloPasso" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="Margin" Value="0,18,0,0" />
        </Style>
        <Style x:Key="TextoPasso" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Icone}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Mesa" TargetType="Border">
            <Setter Property="Height" Value="150" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#0C0D10" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="PilulaGuia" TargetType="Border">
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="6,0,7,0" />
            <Setter Property="Background" Value="{DynamicResource Fundo}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="BotaoPrincipalGuia" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12" Background="{DynamicResource Acento}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinhaItem" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource Cartao}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border x:Name="Painel" Margin="20" CornerRadius="16" Padding="22"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1"
            MouseLeftButtonDown="Painel_Arrastar">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.36" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!-- Cabeçalho -->
            <Grid>
                <TextBlock x:Name="Contagem" Text="Conhecendo a Kisland · 1 de 9" FontSize="12" FontWeight="Medium"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextoFraco}" />
                <Button HorizontalAlignment="Right" Cursor="Hand" Click="Pular_Click" ToolTip="Fechar o guia">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="10" Padding="12,7" Background="Transparent">
                                <TextBlock Text="Pular" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Cartao}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Os passos ocupam a mesma altura, para os botões não pularem. -->
            <Grid Height="440" Margin="0,16,0,0">

                <!-- ========================= PASSO 1 ========================= -->
                <StackPanel x:Name="Passo1">
                    <Border Style="{StaticResource Mesa}">
                        <Grid>
                            <Border Width="180" Height="90" CornerRadius="0,0,10,10" Background="#2B2F38"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,0,0,0" />
                            <Border Width="150" Height="70" CornerRadius="0,0,10,10" Background="{DynamicResource Acento}"
                                    Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,50,0" />
                            <Border Style="{StaticResource PilulaGuia}">
                                <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Chip}"><Path Data="M9,18 L9,5 L21,3 L21,16 M9,18 A3,3 0 1,1 3,18 A3,3 0 1,1 9,18 M21,16 A3,3 0 1,1 15,16 A3,3 0 1,1 21,16" Stroke="{DynamicResource Icone}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" /></Border><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="10,0,4,0"><Rectangle Style="{StaticResource BarraGuia}" Height="7" /><Rectangle Style="{StaticResource BarraGuia}" Height="16" /><Rectangle Style="{StaticResource BarraGuia}" Height="10" /><Rectangle Style="{StaticResource BarraGuia}" Height="13" Margin="0" /></StackPanel><Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M14,14.8 L14,4 A2,2 0 1,0 10,4 L10,14.8 A4,4 0 1,0 14,14.8 Z" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="CPU 62°" /></StackPanel></Border><Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M5,6 L19,6 A2,2 0 0,1 21,8 L21,16 A2,2 0 0,1 19,18 L5,18 A2,2 0 0,1 3,16 L3,8 A2,2 0 0,1 5,6 Z M7,10 L11,10" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="GPU 58°" /></StackPanel></Border><Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" StrokeThickness="1.6" Data="M5,9.9 C5,9.4 5.4,9 5.9,9 L8,9 L11,6.5 C11.6,6 12.5,6.4 12.5,7.2 L12.5,16.8 C12.5,17.6 11.6,18 11,17.5 L8,15 L5.9,15 C5.4,15 5,14.6 5,14.1 Z M15.6,10.2 C16.4,11.2 16.4,12.8 15.6,13.8 M17.9,8.3 C19.7,10.4 19.7,13.6 17.9,15.7" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="70%" /></StackPanel></Border></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Oi, essa é a Kisland" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Sabe aquela barrinha no topo dos iPhones mais novos? A Kisland é a versão do KInfo para o seu PC: mostra o que está tocando, a temperatura e o volume, sem tirar você do que está fazendo." />
                    <Border Style="{StaticResource LinhaItem}" Margin="0,16,0,0" Padding="12,10">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                                <TextBlock Text="Ligar a Kisland" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Mudou de ideia? É só desligar na Personalização." FontSize="11"
                                           Margin="0,2,0,0" Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="Ligar" Style="{StaticResource Interruptor}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================= PASSO 2 ========================= -->
                <StackPanel x:Name="Passo2" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Border Width="300" Height="128" Margin="0,10,0,0" CornerRadius="12" Padding="12"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Background="{DynamicResource Fundo}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Chip}"
                                            HorizontalAlignment="Left" />
                                    <StackPanel Margin="44,6,40,0">
                                        <Border Height="6" Width="120" CornerRadius="3" Background="#3A4150" HorizontalAlignment="Left" />
                                        <Border Height="6" Width="80" CornerRadius="3" Margin="0,6,0,0" Background="{DynamicResource Trilho}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <Ellipse Width="26" Height="26" Fill="{DynamicResource Acento}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Height="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource Trilho}" />
                                    <Border CornerRadius="2" Background="{DynamicResource Acento}" />
                                </Grid>
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Border Height="34" CornerRadius="8" Margin="0,0,3,0" Padding="8,0"
                                            Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                                        <TextBlock Text="62°" FontSize="18" FontWeight="Light" FontFamily="{StaticResource FonteNumero}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                    </Border>
                                    <Border Height="34" CornerRadius="8" Margin="3,0,0,0" Padding="8,0"
                                            Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                                        <TextBlock Text="58°" FontSize="18" FontWeight="Light" FontFamily="{StaticResource FonteNumero}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Passou o mouse, ela abre" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Passa o mouse por cima e pronto: aparecem o player, as temperaturas, o volume e os modos de energia. Tirou o mouse, ela se recolhe de novo." />
                    <Border CornerRadius="14" Margin="0,16,0,0" Padding="4" Background="{DynamicResource Cartao}"
                            BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="AbrirPassando" Style="{StaticResource Aba}" GroupName="AberturaGuia"
                                         Content="Passando o mouse" Checked="Opcao_Alterada" />
                            <RadioButton x:Name="AbrirClicando" Style="{StaticResource Aba}" GroupName="AberturaGuia"
                                         Content="Clicando" Checked="Opcao_Alterada" />
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- ========================= PASSO 3 ========================= -->
                <StackPanel x:Name="Passo3" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Border Style="{StaticResource PilulaGuia}" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><StackPanel x:Name="PreviaMusica" Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Chip}"><Path Data="M9,18 L9,5 L21,3 L21,16 M9,18 A3,3 0 1,1 3,18 A3,3 0 1,1 9,18 M21,16 A3,3 0 1,1 15,16 A3,3 0 1,1 21,16" Stroke="{DynamicResource Icone}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" /></Border><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="10,0,4,0"><Rectangle Style="{StaticResource BarraGuia}" Height="7" /><Rectangle Style="{StaticResource BarraGuia}" Height="16" /><Rectangle Style="{StaticResource BarraGuia}" Height="10" /><Rectangle Style="{StaticResource BarraGuia}" Height="13" Margin="0" /></StackPanel></StackPanel><Border x:Name="PreviaCpu" Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M14,14.8 L14,4 A2,2 0 1,0 10,4 L10,14.8 A4,4 0 1,0 14,14.8 Z" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="CPU 62°" /></StackPanel></Border><Border x:Name="PreviaGpu" Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M5,6 L19,6 A2,2 0 0,1 21,8 L21,16 A2,2 0 0,1 19,18 L5,18 A2,2 0 0,1 3,16 L3,8 A2,2 0 0,1 5,6 Z M7,10 L11,10" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="GPU 58°" /></StackPanel></Border><Border x:Name="PreviaRam" Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M4,8 L20,8 A1,1 0 0,1 21,9 L21,15 A1,1 0 0,1 20,16 L4,16 A1,1 0 0,1 3,15 L3,9 A1,1 0 0,1 4,8 Z M7,16 L7,19 M12,16 L12,19 M17,16 L17,19" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="RAM 53%" /></StackPanel></Border><Border x:Name="PreviaVolume" Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" StrokeThickness="1.6" Data="M5,9.9 C5,9.4 5.4,9 5.9,9 L8,9 L11,6.5 C11.6,6 12.5,6.4 12.5,7.2 L12.5,16.8 C12.5,17.6 11.6,18 11,17.5 L8,15 L5.9,15 C5.4,15 5,14.6 5,14.1 Z M15.6,10.2 C16.4,11.2 16.4,12.8 15.6,13.8 M17.9,8.3 C19.7,10.4 19.7,13.6 17.9,15.7" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="70%" /></StackPanel></Border><Border x:Name="PreviaRelogio" Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M12,3 A9,9 0 1,1 11.99,3 Z M12,7 L12,12 L15,14" /><TextBlock x:Name="PreviaHora" Style="{StaticResource TextoChipGuia}" Text="--:--" /></StackPanel></Border><Border x:Name="PreviaBotao" Width="30" Height="30" CornerRadius="15" Margin="6,0,0,0" Background="{DynamicResource Chip}"><Path Data="M12,3 A9,9 0 1,0 12,21 A2,2 0 0,0 14,19 C14,18 13,17.5 13,16.5 C13,15.5 13.7,15 15,15 L17,15 A3,3 0 0,0 20,12 C20,7 16,3 12,3 Z" Stroke="{DynamicResource Icone}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" /></Border><Grid x:Name="PreviaAnel" Width="32" Height="32" VerticalAlignment="Center"><Ellipse Width="30" Height="30" Stroke="{DynamicResource Acento}" StrokeThickness="1" Opacity="0.28" /><Ellipse Width="21" Height="21" Stroke="{DynamicResource Acento}" StrokeThickness="3.5" /></Grid></StackPanel>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Você escolhe o que aparece" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Marca o que você quer ver. Se não marcar nada e não tiver música tocando, ela vira só um circulozinho no topo." />
                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Border Style="{StaticResource LinhaItem}" Margin="0,0,4,8">
                            <Grid>
                                <TextBlock Text="Música" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemMusica" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LinhaItem}" Margin="4,0,0,8">
                            <Grid>
                                <TextBlock Text="CPU" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemCpu" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LinhaItem}" Margin="0,0,4,8">
                            <Grid>
                                <TextBlock Text="GPU" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemGpu" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LinhaItem}" Margin="4,0,0,8">
                            <Grid>
                                <TextBlock Text="Volume" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemVolume" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LinhaItem}" Margin="0,0,4,0">
                            <Grid>
                                <TextBlock Text="RAM" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemRam" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LinhaItem}" Margin="4,0,0,0">
                            <Grid>
                                <TextBlock Text="Relógio" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemRelogio" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- ====================== PASSO CALENDÁRIO ====================== -->
                <StackPanel x:Name="PassoCalendario" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Border Width="330" Margin="0,10,0,0" CornerRadius="12" Padding="14,10"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock x:Name="PreviaMes" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextoFraco}" />
                                        <TextBlock x:Name="PreviaSemana" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource Acento}" />
                                    </StackPanel>
                                    <TextBlock x:Name="PreviaDia" FontSize="40" FontWeight="Light" FontFamily="{StaticResource FonteNumero}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,-4" Foreground="{DynamicResource Texto}" />
                                </Grid>
                                <Grid x:Name="PreviaCalendario" Grid.Column="1" />
                            </Grid>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="O mês inteiro à vista" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Aberta, a Kisland mostra o calendário do mês com o dia de hoje marcado, igualzinho ao widget do iPhone. Fechada, ela pode mostrar a data do lado da hora." />
                    <UniformGrid Columns="2" Margin="0,16,0,0">
                        <Border Style="{StaticResource LinhaItem}" Margin="0,0,4,0">
                            <Grid>
                                <TextBlock Text="Data na Kisland fechada" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,30,0" TextWrapping="Wrap" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemData" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LinhaItem}" Margin="4,0,0,0">
                            <Grid>
                                <TextBlock Text="Calendário na aberta" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,30,0" TextWrapping="Wrap" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemCalendario" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- ======================= PASSO ATALHOS ======================= -->
                <StackPanel x:Name="PassoAtalhos" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Grid>
                            <Border Style="{StaticResource PilulaGuia}">
                                <StackPanel Orientation="Horizontal"><Grid Width="32" Height="32" VerticalAlignment="Center"><Ellipse Width="30" Height="30" Stroke="{DynamicResource Acento}" StrokeThickness="1" Opacity="0.28" /><Ellipse Width="21" Height="21" Stroke="{DynamicResource Acento}" StrokeThickness="3.5" /></Grid><Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M12,3 A9,9 0 1,1 11.99,3 Z M12,7 L12,12 L15,14" /><TextBlock x:Name="PreviaData" Style="{StaticResource TextoChipGuia}" Foreground="{DynamicResource Acento}" Text="--" /><TextBlock x:Name="PreviaHoraAtalhos" Style="{StaticResource TextoChipGuia}" Text="--:--" /></StackPanel></Border></StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                <StackPanel Margin="10,0"><Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Chip}"><Grid Width="24" Height="24"><Ellipse Width="24" Height="24" Stroke="{DynamicResource Acento}" StrokeThickness="1" Opacity="0.3" /><Ellipse Width="15" Height="15" Stroke="{DynamicResource Acento}" StrokeThickness="2.6" /></Grid></Border><TextBlock Text="Chat de IA" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" /></StackPanel><StackPanel Margin="10,0"><Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Chip}"><TextBlock Text="S" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Acento}" /></Border><TextBlock Text="Spotify" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" /></StackPanel><StackPanel Margin="10,0"><Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Chip}"><TextBlock Text="Y" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Acento}" /></Border><TextBlock Text="Youtube" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" /></StackPanel><StackPanel Margin="10,0"><Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Chip}"><TextBlock Text="D" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Acento}" /></Border><TextBlock Text="Discord" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" /></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="O circulozinho virou atalho" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Escolhe um chat de IA e o anel que pulsa na Kisland passa a abrir ele com um clique. Aberta, ela ainda guarda até 6 apps ou sites seus: é só colocar na Personalização, aba Kisland." />
                    <Border Style="{StaticResource LinhaItem}" Margin="0,16,0,0" Padding="12,10">
                        <Grid>
                            <TextBlock Text="Chat de IA no anel" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                            <ComboBox x:Name="EscolhaIa" Style="{StaticResource Seletor}" MinWidth="130"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      SelectionChanged="Ia_Escolhida" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================= PASSO SOM ========================= -->
                <StackPanel x:Name="PassoSom" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Grid>
                            <Border Style="{StaticResource PilulaGuia}">
                                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource ChipGuia}" Margin="0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" StrokeThickness="1.6" Data="M5,9.9 C5,9.4 5.4,9 5.9,9 L8,9 L11,6.5 C11.6,6 12.5,6.4 12.5,7.2 L12.5,16.8 C12.5,17.6 11.6,18 11,17.5 L8,15 L5.9,15 C5.4,15 5,14.6 5,14.1 Z M15.6,10.2 C16.4,11.2 16.4,12.8 15.6,13.8 M17.9,8.3 C19.7,10.4 19.7,13.6 17.9,15.7" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="72%" /></StackPanel></Border><Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" StrokeThickness="1.8" Data="M4,13 L7,5 L17,5 L20,13 L20,18 A2,2 0 0,1 18,20 L6,20 A2,2 0 0,1 4,18 Z M4,13 L9,13 L10,15 L14,15 L15,13 L20,13" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="3" /></StackPanel></Border></StackPanel>
                            </Border>
                            <!-- O mouse com a roda girando, ao lado da Kisland. -->
                            <Path Data="M12,3 A6,6 0 0,1 18,9 L18,15 A6,6 0 0,1 6,15 L6,9 A6,6 0 0,1 12,3 Z M12,7 L12,10"
                                  Stroke="{DynamicResource Acento}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="250,20,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                                <Border CornerRadius="13" Padding="10,5" Margin="0,0,6,0" Background="{DynamicResource InfoFundo}" BorderBrush="{DynamicResource Acento}" BorderThickness="1">
                                    <TextBlock Text="Fones de ouvido" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource InfoTexto}" />
                                </Border>
                                <Border CornerRadius="13" Padding="10,5" Margin="0,0,6,0" Background="{DynamicResource Chip}" BorderBrush="{DynamicResource Trilho}" BorderThickness="1">
                                    <TextBlock Text="Alto-falantes" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Texto}" />
                                </Border>
                                <Border CornerRadius="13" Padding="10,5" Background="{DynamicResource Chip}" BorderBrush="{DynamicResource Trilho}" BorderThickness="1">
                                    <TextBlock Text="Monitor" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Texto}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Som e arquivos na ponta do mouse" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Gira a roda do mouse em cima da Kisland para mudar o volume, e clica com a roda para pausar a música. Aberta, ela passa o som para o fone, a caixa ou o monitor num clique. E dá para arrastar arquivos até ela: eles ficam ali, à mão, até você usar." />
                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <Border Style="{StaticResource LinhaItem}" Margin="0,0,4,0">
                            <Grid>
                                <TextBlock Text="Roda no volume" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,30,0" TextWrapping="Wrap" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemRoda" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LinhaItem}" Margin="4,0,4,0">
                            <Grid>
                                <TextBlock Text="Trocar saída" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,30,0" TextWrapping="Wrap" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemSaidas" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LinhaItem}" Margin="4,0,0,0">
                            <Grid>
                                <TextBlock Text="Bandeja" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,30,0" TextWrapping="Wrap" Foreground="{DynamicResource Texto}" />
                                <CheckBox x:Name="ItemBandeja" Style="{StaticResource CaixaDeSelecao}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- ========================= PASSO 4 ========================= -->
                <StackPanel x:Name="Passo4" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="150" Height="96" CornerRadius="8" Background="{DynamicResource Cartao}"
                                    BorderBrush="{DynamicResource Trilho}" BorderThickness="2" />
                            <Path Data="M2,8 L32,8 M26,2 L32,8 L26,14" Stroke="{DynamicResource Acento}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="36" Height="16" Stretch="None" Margin="22,0" VerticalAlignment="Center" />
                            <Border Width="150" Height="96" CornerRadius="8" Background="{DynamicResource Cartao}"
                                    BorderBrush="{DynamicResource Acento}" BorderThickness="2">
                                <Border Width="64" Height="12" CornerRadius="6" Margin="0,6,0,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Background="{DynamicResource Fundo}" BorderBrush="#3A4150" BorderThickness="1" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Funciona em qualquer tela" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Tem mais de um monitor? Arrasta a Kisland para onde quiser, que ela se ajeita no topo e lembra da escolha. Jogo ou filme em tela cheia? Ela sai da frente sozinha." />
                </StackPanel>

                <!-- ======================== PASSO FPS ======================== -->
                <StackPanel x:Name="PassoFps" Visibility="Collapsed">
                    <!-- Um "jogo" ocupando a tela, e a Kisland enxuta, no modo jogo. -->
                    <Border Style="{StaticResource Mesa}">
                        <Grid>
                            <Border Background="#1B2433" />
                            <Border Height="70" VerticalAlignment="Bottom" Background="#253247" />
                            <Ellipse Width="90" Height="90" Fill="{DynamicResource Acento}" Opacity="0.25"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,60,0" />
                            <Border Style="{StaticResource PilulaGuia}" Padding="6,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ChipGuia}" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconeChipGuia}" Stroke="{DynamicResource Acento}"
                                              Data="M6,9 L18,9 A4,4 0 0,1 22,13 L22,15 A3,3 0 0,1 16.5,16.5 L15,15 L9,15 L7.5,16.5 A3,3 0 0,1 2,15 L2,13 A4,4 0 0,1 6,9 Z M7,11 L7,13 M6,12 L8,12 M16,12 L16.01,12 M18,12 L18.01,12" />
                                        <TextBlock Style="{StaticResource TextoChipGuia}" Text="144 FPS" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M14,14.8 L14,4 A2,2 0 1,0 10,4 L10,14.8 A4,4 0 1,0 14,14.8 Z" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="CPU 71°" /></StackPanel></Border>
                                <Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M5,6 L19,6 A2,2 0 0,1 21,8 L21,16 A2,2 0 0,1 19,18 L5,18 A2,2 0 0,1 3,16 L3,8 A2,2 0 0,1 5,6 Z M7,10 L11,10" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="GPU 66°" /></StackPanel></Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Tá jogando? Ela conta o FPS" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="Liga o contador e a Kisland percebe sozinha quando tem um jogo aberto, em qualquer monitor, e mostra o FPS dele. Se o jogo estiver na mesma tela, ela fica enxuta, só com o FPS e o que você escolher para o modo jogo na Personalização." />
                    <Border Style="{StaticResource LinhaItem}" Margin="0,16,0,0" Padding="12,10">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Mostrar o FPS em jogos" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DetalheFps" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}"
                                           Text="Funciona com jogos em DirectX, que são quase todos." />
                            </StackPanel>
                            <CheckBox x:Name="ItemFps" Style="{StaticResource Interruptor}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Opcao_Alterada" Unchecked="Opcao_Alterada" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================= PASSO 5 ========================= -->
                <StackPanel x:Name="Passo5" Visibility="Collapsed">
                    <Border Style="{StaticResource Mesa}">
                        <Border Style="{StaticResource PilulaGuia}" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Chip}"><Path Data="M9,18 L9,5 L21,3 L21,16 M9,18 A3,3 0 1,1 3,18 A3,3 0 1,1 9,18 M21,16 A3,3 0 1,1 15,16 A3,3 0 1,1 21,16" Stroke="{DynamicResource Icone}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" /></Border><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="10,0,4,0"><Rectangle Style="{StaticResource BarraGuia}" Height="7" /><Rectangle Style="{StaticResource BarraGuia}" Height="16" /><Rectangle Style="{StaticResource BarraGuia}" Height="10" /><Rectangle Style="{StaticResource BarraGuia}" Height="13" Margin="0" /></StackPanel><Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M14,14.8 L14,4 A2,2 0 1,0 10,4 L10,14.8 A4,4 0 1,0 14,14.8 Z" /><TextBlock Style="{StaticResource TextoChipGuia}" Text="CPU 62°" /></StackPanel></Border><Border Style="{StaticResource ChipGuia}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconeChipGuia}" Data="M12,3 A9,9 0 1,1 11.99,3 Z M12,7 L12,12 L15,14" /><TextBlock x:Name="PreviaHora5" Style="{StaticResource TextoChipGuia}" Text="--:--" /></StackPanel></Border><Border Width="30" Height="30" CornerRadius="15" Margin="6,0,0,0" Background="{DynamicResource Chip}"><Path Data="M12,3 A9,9 0 1,0 12,21 A2,2 0 0,0 14,19 C14,18 13,17.5 13,16.5 C13,15.5 13.7,15 15,15 L17,15 A3,3 0 0,0 20,12 C20,7 16,3 12,3 Z" Stroke="{DynamicResource Icone}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" /></Border></StackPanel>
                        </Border>
                    </Border>
                    <TextBlock Style="{StaticResource TituloPasso}" Text="Combina com o seu KInfo" />
                    <TextBlock Style="{StaticResource TextoPasso}"
                               Text="A Kisland usa as mesmas cores do KInfo: trocou lá, troca aqui também. Escolhe uma para testar. E o botãozinho com a paleta, no canto dela, leva direto para os ajustes." />
                    <UniformGrid x:Name="Cores" Columns="6" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>

            <!-- Rodapé -->
            <Grid Margin="0,18,0,0">
                <StackPanel x:Name="Pontos" Orientation="Horizontal" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BotaoVoltar" Style="{StaticResource BotaoLargo}" Width="96" Margin="0,0,8,0"
                            Content="Voltar" Click="Voltar_Click" />
                    <Button x:Name="BotaoAvancar" Style="{StaticResource BotaoPrincipalGuia}" MinWidth="110"
                            Content="Próximo" Click="Avancar_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
