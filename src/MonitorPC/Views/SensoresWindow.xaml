<Window x:Class="MonitorPC.Views.SensoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todos os sensores"
        Width="472" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Todos os sensores" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock x:Name="Subtitulo" FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <Border Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource Chip}"
                    BorderBrush="{DynamicResource Trilho}" BorderThickness="1" Padding="10,0">
                <Grid>
                    <TextBox x:Name="Busca" Height="36" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" FontSize="12"
                             Foreground="{DynamicResource Texto}"
                             CaretBrush="{DynamicResource Texto}"
                             TextChanged="Busca_Alterada" />
                    <TextBlock x:Name="Dica" Text="Filtrar por nome, componente ou unidade"
                               FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextoMuitoFraco}" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,4,6,8">
                <Grid>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                  PanningMode="VerticalOnly">
                        <StackPanel x:Name="Lista" Margin="0,0,6,0" />
                    </ScrollViewer>
                    <TextBlock x:Name="Vazio" FontSize="12" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="12,24,12,24"
                               Foreground="{DynamicResource TextoMuitoFraco}" />
                </Grid>
            </Border>

            <TextBlock FontSize="11" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="Tudo que o hardware reporta, inclusive o que as abas não mostram. Nomes sem rótulo vêm assim do próprio chip da placa-mãe." />

        </StackPanel>
    </Border>
</Window>
