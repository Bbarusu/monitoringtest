<Window x:Class="MonitorPC.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KInfo"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20"
            MouseLeftButtonDown="Painel_Arrastar">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!-- Cabecalho: o titulo e os chips mudam conforme a aba -->
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Titulo" Text="Meu PC" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                        <ComboBox x:Name="SeletorDisco" Style="{StaticResource Seletor}"
                                  Visibility="Collapsed" Margin="10,1,0,0" MaxWidth="150"
                                  SelectionChanged="SeletorDisco_Alterado" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="{DynamicResource Chip}" BorderBrush="{DynamicResource Trilho}"
                                BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="IconeEsquerdo" Stroke="{DynamicResource TextoFraco}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"
                                      Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="ChipEsquerdo" Text="-- °C" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Chip}" BorderBrush="{DynamicResource Trilho}"
                                BorderThickness="1" CornerRadius="10" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="IconeDireito" Stroke="{DynamicResource TextoFraco}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"
                                      Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="ChipDireito" Text="RAM --%" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource BotaoRedondoFraco}" Margin="0,0,8,0"
                            ToolTip="Minimizar painel" Click="Minimizar_Click">
                        <Path Data="M5,12 L19,12" Stroke="{DynamicResource Icone}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource BotaoRedondo}"
                            ToolTip="Encerrar o KInfo" Click="Encerrar_Click">
                        <Path Data="M12,3 L12,11 M6.5,6.5 A8,8 0 1,0 17.5,6.5"
                              Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Aviso: driver de sensores -->
            <Border x:Name="AvisoDriver" Visibility="Collapsed" Margin="0,16,0,0"
                    CornerRadius="12" Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}"
                    BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="AvisoDriverTexto"
                               Foreground="{DynamicResource AlertaTexto}" FontSize="12" TextWrapping="Wrap" />

                    <!-- Só aparece quando elevar não é a resposta: sem isso o
                         usuário não tem como nos dizer o que o Windows recusou. -->
                    <Button x:Name="BotaoDiagnostico" Visibility="Collapsed"
                            Style="{StaticResource BotaoLargo}" Margin="0,10,0,0"
                            Content="Salvar relatório do problema"
                            ToolTip="Grava um arquivo com o que o app encontrou e abre a pasta"
                            Click="Diagnostico_Click" />
                </StackPanel>
            </Border>


            <!-- Aviso de temperatura -->
            <Border x:Name="AvisoTemperatura" Visibility="Collapsed" Margin="0,16,0,0"
                    CornerRadius="12" Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}"
                    BorderThickness="1" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AvisoChip}"
                                VerticalAlignment="Top">
                            <Path Data="M12,3 L22,21 L2,21 Z M12,10 L12,15 M12,18 L12,18.01"
                                  Stroke="{DynamicResource AvisoIcone}" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AvisoTitulo" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Texto}" TextWrapping="Wrap" MaxWidth="300"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="AvisoDetalhe" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource AlertaTexto}" />
                        </StackPanel>
                    </StackPanel>

                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Button x:Name="BotaoEconomico" Height="40" Margin="0,0,4,0"
                                Click="AvisoEconomico_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" CornerRadius="10" Background="{DynamicResource AvisoBotao}">
                                        <TextBlock Text="Ativar Econômico" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AvisoBotaoTexto}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BotaoSilenciar" Height="40" Margin="4,0,0,0"
                                Click="AvisoSilenciar_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" CornerRadius="10" Background="Transparent"
                                            BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1">
                                        <TextBlock Text="Silenciar 10 min" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource AlertaTexto}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AvisoChip}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ======================= TOPO: GERAL ======================= -->
            <StackPanel x:Name="TopoGeral">
                <Grid Width="220" Height="220" Margin="0,16,0,0">
                    <Ellipse Width="200" Height="200" Stroke="{DynamicResource Trilho}" StrokeThickness="10" />
                    <Path x:Name="Anel" Stroke="{DynamicResource Acento}" StrokeThickness="10"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="ValorPrincipal" Text="--" FontSize="76" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                       LineHeight="78" />
                            <TextBlock Text="°C" FontSize="24" Foreground="{DynamicResource TextoFraco}"
                                       Margin="4,10,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="LegendaPrincipal" Text="CPU" FontSize="12" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                </Grid>

                <!-- As duas colunas se dividem pela carga: o preenchimento acompanha a
                     largura real do painel, sem conta em pixels que possa dar negativa. -->
                <Grid Margin="0,8,0,0">
                    <Border Height="6" CornerRadius="3" Background="{DynamicResource Trilho}"
                            VerticalAlignment="Center" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColunaCheia" Width="0*" />
                            <ColumnDefinition x:Name="ColunaVazia" Width="100*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BarraCarga" Grid.Column="0" Height="6" CornerRadius="3"
                                Background="{DynamicResource Acento}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="0%" FontSize="11" Foreground="{DynamicResource TextoMuitoFraco}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="50%" FontSize="11" Foreground="{DynamicResource TextoMuitoFraco}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="100%" FontSize="11" Foreground="{DynamicResource TextoMuitoFraco}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- ======================== TOPO: CPU ======================== -->
            <StackPanel x:Name="TopoCpu" Visibility="Collapsed" Margin="0,16,0,0">
                <Grid Height="150">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Ellipse Width="138" Height="138" Stroke="{DynamicResource Trilho}" StrokeThickness="9" />
                        <Path x:Name="AnelCpu" Stroke="{DynamicResource Acento}" StrokeThickness="9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="CpuUsoTexto" Text="--" FontSize="48" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                           LineHeight="50" />
                                <TextBlock Text="%" FontSize="18" Foreground="{DynamicResource TextoFraco}"
                                           Margin="2,6,0,0" />
                            </StackPanel>
                            <TextBlock Text="Uso total" FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid Height="36">
                            <TextBlock Text="Temperatura" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="CpuTempTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Clock" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="CpuClockTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Potência" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="CpuWattsTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Tensão" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="CpuTensaoTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Historico da carga -->
                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Carga · últimos 5 min" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CpuPicoHistorico" Text="" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Right" />
                </Grid>
                <Grid x:Name="AreaGrafico" Height="80" Margin="0,6,0,0" ClipToBounds="True"
                      SizeChanged="AreaGrafico_SizeChanged">
                    <Border Height="1" Background="{DynamicResource Borda}" VerticalAlignment="Bottom" />
                    <Polygon x:Name="GraficoArea" Fill="{DynamicResource Acento}" Opacity="0.14" />
                    <Polyline x:Name="GraficoLinha" Stroke="{DynamicResource Acento}" StrokeThickness="2"
                              StrokeLineJoin="Round" />
                </Grid>
            </StackPanel>


            <!-- ======================== TOPO: GPU ======================== -->
            <StackPanel x:Name="TopoGpu" Visibility="Collapsed" Margin="0,16,0,0">
                <Grid Height="150">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Ellipse Width="138" Height="138" Stroke="{DynamicResource Trilho}" StrokeThickness="9" />
                        <Path x:Name="AnelGpu" Stroke="{DynamicResource Acento}" StrokeThickness="9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="GpuUsoTexto" Text="--" FontSize="48" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                           LineHeight="50" />
                                <TextBlock Text="%" FontSize="18" Foreground="{DynamicResource TextoFraco}"
                                           Margin="2,6,0,0" />
                            </StackPanel>
                            <TextBlock Text="Uso" FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid Height="36">
                            <TextBlock Text="Temp. borda" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="GpuTempTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Hot spot" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="GpuHotTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Clock núcleo" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="GpuClockTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Clock memória" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="GpuClockMemTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Carga · últimos 5 min" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="GpuPicoHistorico" Text="" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Right" />
                </Grid>
                <Grid x:Name="AreaGraficoGpu" Height="80" Margin="0,6,0,0" ClipToBounds="True"
                      SizeChanged="AreaGraficoGpu_SizeChanged">
                    <Border Height="1" Background="{DynamicResource Borda}" VerticalAlignment="Bottom" />
                    <Polygon x:Name="GraficoAreaGpu" Fill="{DynamicResource Acento}" Opacity="0.14" />
                    <Polyline x:Name="GraficoLinhaGpu" Stroke="{DynamicResource Acento}" StrokeThickness="2"
                              StrokeLineJoin="Round" />
                </Grid>
            </StackPanel>


            <!-- ======================= TOPO: DISCO ======================= -->
            <StackPanel x:Name="TopoDisco" Visibility="Collapsed" Margin="0,16,0,0">
                <Grid Height="150">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Ellipse Width="138" Height="138" Stroke="{DynamicResource Trilho}" StrokeThickness="9" />
                        <Path x:Name="AnelDisco" Stroke="{DynamicResource Acento}" StrokeThickness="9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="DiscoUsoTexto" Text="--" FontSize="48" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                           LineHeight="50" />
                                <TextBlock Text="%" FontSize="18" Foreground="{DynamicResource TextoFraco}"
                                           Margin="2,6,0,0" />
                            </StackPanel>
                            <TextBlock Text="Atividade" FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid Height="36">
                            <TextBlock Text="Leitura" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="DiscoLeituraTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Escrita" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="DiscoEscritaTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Temperatura" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="DiscoTempTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="36">
                            <TextBlock Text="Vida útil" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="DiscoVidaTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Atividade · últimos 5 min" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="DiscoPicoHistorico" Text="" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Right" />
                </Grid>
                <Grid x:Name="AreaGraficoDisco" Height="80" Margin="0,6,0,0" ClipToBounds="True"
                      SizeChanged="AreaGraficoDisco_SizeChanged">
                    <Border Height="1" Background="{DynamicResource Borda}" VerticalAlignment="Bottom" />
                    <Polygon x:Name="GraficoAreaDisco" Fill="{DynamicResource Acento}" Opacity="0.14" />
                    <Polyline x:Name="GraficoLinhaDisco" Stroke="{DynamicResource Acento}" StrokeThickness="2"
                              StrokeLineJoin="Round" />
                </Grid>
            </StackPanel>


            <!-- ====================== TOPO: ENERGIA ====================== -->
            <StackPanel x:Name="TopoEnergia" Visibility="Collapsed" Margin="0,16,0,0">
                <Grid Height="150">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Ellipse Width="138" Height="138" Stroke="{DynamicResource Trilho}" StrokeThickness="9" />
                        <Path x:Name="AnelEnergia" Stroke="{DynamicResource Acento}" StrokeThickness="9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="EnergiaWattsTexto" Text="--" FontSize="44" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                           LineHeight="46" />
                                <TextBlock Text="W" FontSize="18" Foreground="{DynamicResource TextoFraco}"
                                           Margin="2,6,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="EnergiaLegenda" Text="Potência agora" FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                    </Grid>

                    <!--
                        Cinco linhas em 150 px: 29 de altura cada, mais os
                        separadores de 1. "Hoje" acompanha "Sessão" porque
                        sozinha a sessão não responde quanto o PC gastou no dia.
                    -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid Height="29">
                            <TextBlock Text="Sessão" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="EnergiaSessaoTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="29">
                            <TextBlock Text="Hoje" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="EnergiaHojeTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="29">
                            <TextBlock Text="Média" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="EnergiaMediaTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="29">
                            <TextBlock Text="Pico" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="EnergiaPicoTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Borda}" />
                        <Grid Height="29">
                            <TextBlock Text="Na tomada" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <TextBlock x:Name="EnergiaTomadaTexto" Text="--" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Texto}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- A ressalva fica colada no número, não escondida num tooltip. -->
                <TextBlock x:Name="LegendaDoConsumo" FontSize="11" Margin="0,12,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextoMuitoFraco}" />

                <Grid Margin="0,16,0,0">
                    <TextBlock Text="Potência · últimos 5 min" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="EnergiaPicoHistorico" Text="" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Right" />
                </Grid>
                <Grid x:Name="AreaGraficoEnergia" Height="80" Margin="0,6,0,0" ClipToBounds="True"
                      SizeChanged="AreaGraficoEnergia_SizeChanged">
                    <Border Height="1" Background="{DynamicResource Borda}" VerticalAlignment="Bottom" />
                    <Polygon x:Name="GraficoAreaEnergia" Fill="{DynamicResource Acento}" Opacity="0.14" />
                    <Polyline x:Name="GraficoLinhaEnergia" Stroke="{DynamicResource Acento}" StrokeThickness="2"
                              StrokeLineJoin="Round" />
                </Grid>
            </StackPanel>

            <!-- ========================== ABAS =========================== -->
            <Border Margin="0,16,0,0" CornerRadius="14" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="4">
                <UniformGrid Columns="5">
                    <RadioButton x:Name="AbaGeral" Style="{StaticResource Aba}" Content="Geral"
                                 IsChecked="True" Checked="Aba_Selecionada" />
                    <RadioButton x:Name="AbaCpu" Style="{StaticResource Aba}" Content="CPU"
                                 Checked="Aba_Selecionada" />
                    <RadioButton x:Name="AbaGpu" Style="{StaticResource Aba}" Content="GPU"
                                 Checked="Aba_Selecionada" />
                    <RadioButton x:Name="AbaDisco" Style="{StaticResource Aba}" Content="Disco"
                                 Checked="Aba_Selecionada" />
                    <RadioButton x:Name="AbaEnergia" Style="{StaticResource Aba}" Content="Energia"
                                 Checked="Aba_Selecionada" />
                </UniformGrid>
            </Border>

            <!-- ======================= BASE: GERAL ======================= -->
            <StackPanel x:Name="BaseGeral">
                <UniformGrid Columns="2" Margin="0,16,0,0">
                    <Button Margin="0,0,6,0" Cursor="Hand" Click="CardGpu_Click"
                            ToolTip="Ver os programas que mais usam a placa de vídeo">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="12" Height="56" Padding="12,0"
                                        Background="{DynamicResource Cartao}"
                                        BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="{DynamicResource Trilho}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GPU" FontSize="11"
                                           Foreground="{DynamicResource TextoFraco}" />
                                <TextBlock x:Name="CardGpu" Text="--" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Texto}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Path Data="M9,6 L15,12 L9,18" Stroke="{DynamicResource IconeFraco}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <!-- O conteudo fica fora do template: x:Name dentro de um
                         ControlTemplate nao vira campo no codigo. -->
                    <Button Margin="6,0,0,0" Cursor="Hand" Click="CardRam_Click"
                            ToolTip="Ver os programas que mais usam memória">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="12" Height="56" Padding="12,0"
                                        Background="{DynamicResource Cartao}"
                                        BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="{DynamicResource Trilho}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RAM" FontSize="11"
                                           Foreground="{DynamicResource TextoFraco}" />
                                <TextBlock x:Name="CardRam" Text="--" FontSize="14"
                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Texto}" />
                            </StackPanel>
                            <Path Data="M9,6 L15,12 L9,18" Stroke="{DynamicResource IconeFraco}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </UniformGrid>

                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <RadioButton x:Name="PerfilEconomico" Style="{StaticResource Perfil}"
                                 Content="Econômico" Margin="0,0,6,0" Click="Perfil_Click" />
                    <RadioButton x:Name="PerfilEquilibrado" Style="{StaticResource Perfil}"
                                 Content="Equilibrado" Margin="6,0,6,0" Click="Perfil_Click" />
                    <RadioButton x:Name="PerfilDesempenho" Style="{StaticResource Perfil}"
                                 Content="Desempenho" Margin="6,0,0,0" Click="Perfil_Click" />
                </UniformGrid>
            </StackPanel>

            <!-- ======================== BASE: CPU ======================== -->
            <StackPanel x:Name="BaseCpu" Visibility="Collapsed">
                <Grid x:Name="RotuloBarrasCpu" Margin="0,16,0,10">
                    <TextBlock Text="Potência e resfriamento" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                </Grid>
                <StackPanel x:Name="BarrasCpu" />

                <Grid Margin="0,6,0,8">
                    <TextBlock x:Name="RotuloGrade" Text="Uso por núcleo" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="DetectadoCpu" Text="" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Right" />
                </Grid>

                <!-- A grade e montada em codigo: a contagem vem do hardware -->
                <UniformGrid x:Name="GradeNucleos" Columns="2" />

                <Button Style="{StaticResource BotaoLargo}" Height="40" Margin="0,10,0,0"
                        Click="Estresse_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M13,2 L4,14 L11,14 L10,22 L19,10 L12,10 Z"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform"
                              Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Teste de estresse" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Margin="0,10,0,0">
                    <TextBlock Text="Grade" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextoMuitoFraco}" />
                    <Border CornerRadius="10" Background="{DynamicResource Cartao}" Width="168"
                            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="3"
                            HorizontalAlignment="Right">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="ModoNucleos" Style="{StaticResource Aba}" Height="28"
                                         FontSize="11" Content="Núcleos" IsChecked="True"
                                         Checked="ModoGrade_Alterado" />
                            <RadioButton x:Name="ModoThreads" Style="{StaticResource Aba}" Height="28"
                                         FontSize="11" Content="Threads" Checked="ModoGrade_Alterado" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </StackPanel>


            <!-- ======================== BASE: GPU ======================== -->
            <StackPanel x:Name="BaseGpu" Visibility="Collapsed">
                <Border x:Name="AvisoHotSpot" Visibility="Collapsed" Margin="0,16,0,0"
                        CornerRadius="12" Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}"
                        BorderThickness="1" Padding="12">
                    <TextBlock x:Name="TextoHotSpot" Foreground="{DynamicResource AlertaTexto}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <Grid Margin="0,16,0,10">
                    <TextBlock Text="Memória e resfriamento" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                </Grid>
                <StackPanel x:Name="BarrasGpu" />
            </StackPanel>


            <!-- ======================= BASE: DISCO ======================= -->
            <StackPanel x:Name="BaseDisco" Visibility="Collapsed">
                <Grid Margin="0,16,0,10">
                    <TextBlock Text="Taxas e temperatura" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                </Grid>
                <StackPanel x:Name="BarrasDisco" />

                <Grid Margin="0,6,0,10">
                    <TextBlock x:Name="RotuloListaDisco" Text="Consumindo o disco agora" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                    <Border CornerRadius="10" Background="{DynamicResource Cartao}" Width="168"
                            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="3"
                            HorizontalAlignment="Right">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="ModoProcessos" Style="{StaticResource Aba}" Height="28"
                                         FontSize="11" Content="Processos" IsChecked="True"
                                         Checked="ModoDisco_Alterado" />
                            <RadioButton x:Name="ModoUnidades" Style="{StaticResource Aba}" Height="28"
                                         FontSize="11" Content="Unidades" Checked="ModoDisco_Alterado" />
                        </UniformGrid>
                    </Border>
                </Grid>
                <StackPanel x:Name="ListaDisco" />
                <Button x:Name="BotaoLog" Style="{StaticResource BotaoLargo}" Height="40"
                        Margin="0,4,0,0" Click="Log_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,6 L20,6 M8,12 L20,12 M8,18 L20,18 M4,6 L4.01,6 M4,12 L4.01,12 M4,18 L4.01,18"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"
                              Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ver log detalhado" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>


            <!-- ====================== BASE: ENERGIA ====================== -->
            <StackPanel x:Name="BaseEnergia" Visibility="Collapsed">
                <Grid Margin="0,16,0,10">
                    <TextBlock Text="Para onde vai a energia" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Left" />
                    <TextBlock Text="agora" FontSize="11"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Right" />
                </Grid>

                <Grid Height="10">
                    <Border CornerRadius="5" Background="{DynamicResource Trilho}" />
                    <Grid x:Name="FaixaEnergia" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FaixaGpu" Width="0*" />
                            <ColumnDefinition x:Name="FaixaCpu" Width="0*" />
                            <ColumnDefinition x:Name="FaixaOutros" Width="100*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Acento}"
                                CornerRadius="5,0,0,5" />
                        <Border Grid.Column="1" Background="{DynamicResource SerieMedida}" />
                        <Border Grid.Column="2" Background="{DynamicResource SerieEstimada}" CornerRadius="0,5,5,0" />
                    </Grid>
                </Grid>

                <StackPanel x:Name="LegendaEnergia" Margin="0,12,0,0" />

                <TextBlock x:Name="NotaEnergia" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextoMuitoFraco}" />
                <Button Style="{StaticResource BotaoLargo}" Height="40" Margin="0,10,0,0"
                        Click="Componentes_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M4,8 L14,8 M18,8 L20,8 M4,16 L6,16 M10,16 L20,16"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"
                              Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Configurar componentes" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BotaoLargo}" Height="40" Margin="0,8,0,0"
                        Click="RegistroDeConsumo_Click"
                        ToolTip="Abre o arquivo de texto com o consumo de cada dia">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M6,3 L15,3 L19,7 L19,21 L6,21 Z M15,3 L15,7 L19,7 M9,12 L16,12 M9,16 L16,16"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform"
                              Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Registro de consumo por dia" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ========================= RODAPE ========================== -->
            <Grid Margin="0,16,0,0">
                <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Icone}" Text="Sensores ativos" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BotaoIcone}" ToolTip="Personalização"
                            Margin="0,0,8,0" Click="Personalizar_Click">
                        <Path Data="M12,3 A9,9 0 1,0 12,21 A2,2 0 0,0 14,19 C14,18 13,17.5 13,16.5 C13,15.5 13.7,15 15,15 L17,15 A3,3 0 0,0 20,12 C20,7 16,3 12,3 Z"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource BotaoIcone}" ToolTip="Todos os sensores"
                            Margin="0,0,8,0" Click="Sensores_Click">
                        <Path Data="M4,18 L8,18 L10,8 L13,20 L16,13 L20,13"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource BotaoIcone}" ToolTip="Ajustes" Click="Ajustes_Click">
                        <Path Data="M4,8 L14,8 M18,8 L20,8 M4,16 L6,16 M10,16 L20,16"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>
