<Window x:Class="MonitorPC.Views.ComponentesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Componentes de energia"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Componentes de energia" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock Text="As quantidades são detectadas. Ajuste o que o PC não enxerga."
                               FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="320"
                               HorizontalAlignment="Left" Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                <StackPanel>

                    <TextBlock Text="Medidos por sensor" FontSize="11" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextoFraco}" />
                    <StackPanel x:Name="Medidos" />

                    <TextBlock Text="Quantidades" FontSize="11" Margin="0,12,0,8"
                               Foreground="{DynamicResource TextoFraco}" />
                    <StackPanel x:Name="Quantidades" />

                    <TextBlock Text="Watts por unidade" FontSize="11" Margin="0,12,0,8"
                               Foreground="{DynamicResource TextoFraco}" />
                    <StackPanel x:Name="Watts" />

                    <TextBlock Text="Escalas das barras" FontSize="11" Margin="0,12,0,4"
                               Foreground="{DynamicResource TextoFraco}" />
                    <TextBlock Margin="0,0,0,8" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextoMuitoFraco}"
                               Text="Deixe em 0 e mediremos automaticamente." />
                    <StackPanel x:Name="Escalas" />

                    <Button Style="{StaticResource BotaoLargo}" Margin="0,4,0,0"
                            Content="Calibrar ventoinhas" Click="Calibrar_Click" />
                    <TextBlock x:Name="EstadoCatalogo" Margin="0,8,0,0" FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextoMuitoFraco}" />

                    <TextBlock Text="Fonte" FontSize="11" Margin="0,12,0,8"
                               Foreground="{DynamicResource TextoFraco}" />
                    <StackPanel x:Name="Fonte" />

                </StackPanel>
            </ScrollViewer>

            <Border Margin="0,16,0,0" CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Estimativa fixa" FontSize="13"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <TextBlock x:Name="TotalEstimado" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Texto}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="RotuloTomada" Text="Com a CPU e a GPU de agora"
                                   FontSize="13" Foreground="{DynamicResource TextoFraco}" />
                        <TextBlock x:Name="TotalAgora" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Texto}" />
                    </Grid>
                    <TextBlock x:Name="Composicao" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextoMuitoFraco}" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="2" Margin="0,16,0,0">
                <Button Style="{StaticResource BotaoLargo}" Margin="0,0,5,0"
                        Content="Voltar à detecção" Click="Redetectar_Click" />
                <Button Style="{StaticResource BotaoLargo}" Margin="5,0,0,0"
                        Content="Fechar" Click="Voltar_Click" />
            </UniformGrid>

            <TextBlock FontSize="11" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="As mudanças valem na hora e ficam salvas no config.json." />

        </StackPanel>
    </Border>
</Window>
