<Window x:Class="MonitorPC.Views.PersonalizacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalização"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <!--
            Rolagem para tela baixa. Esta janela cresce com o conteúdo, e num
            notebook o conteúdo passa da altura útil; Janelas.LimitarAltura põe
            o teto, e sem rolagem o teto cortaria em vez de passar da tela —
            troca de um problema por outro. Aqui o conteúdo rola inteiro,
            botões incluídos: são poucas linhas e todas alcançáveis.
        -->
        <!-- A barra de rolagem fica na margem interna do painel, com 6 px de
             folga do conteúdo e da borda: o conteúdo tem a mesma largura com
             ou sem barra, e ela não encosta em nada. -->
        <ScrollViewer x:Name="Rolagem" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,-14,0">
        <StackPanel x:Name="Conteudo" Margin="0,0,14,0">

            <!-- Cabecalho -->
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Personalização" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock Text="Painel e Kisland" FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <!--
                Duas abas: o painel e a Kisland. Cada uma com tudo o que é seu,
                para a lista não virar um corredor onde as opções de uma coisa
                se misturam com as da outra.
            -->
            <Border CornerRadius="14" Margin="0,18,0,0" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="4">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="AbaDoPainel" Style="{StaticResource Aba}" GroupName="AbasDaPersonalizacao"
                                 Content="Painel" IsChecked="True" Checked="Aba_Alterada" />
                    <RadioButton x:Name="AbaDaKisland" Style="{StaticResource Aba}" GroupName="AbasDaPersonalizacao"
                                 Content="Kisland" Checked="Aba_Alterada" />
                </UniformGrid>
            </Border>

            <!-- ========================= ABA PAINEL ========================= -->
            <StackPanel x:Name="AbaPainel">

            <!-- Tema -->
            <TextBlock Text="Tema" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="14" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="4">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="TemaEscuro" Style="{StaticResource Aba}" Content="Escuro"
                                 Checked="Tema_Alterado" />
                    <RadioButton x:Name="TemaPreto" Style="{StaticResource Aba}" Content="Preto"
                                 ToolTip="Preto AMOLED/OLED"
                                 Checked="Tema_Alterado" />
                    <RadioButton x:Name="TemaClaro" Style="{StaticResource Aba}" Content="Claro"
                                 Checked="Tema_Alterado" />
                    <RadioButton x:Name="TemaSistema" Style="{StaticResource Aba}" Content="Sistema"
                                 Checked="Tema_Alterado" />
                </UniformGrid>
            </Border>

            <!-- Cor de destaque -->
            <TextBlock Text="Cor de destaque" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Acompanhar a cor do sistema" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock Text="Usa a cor de destaque do Windows" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="SeguirSistema" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="SeguirSistema_Alterado" Unchecked="SeguirSistema_Alterado" />
                </Grid>
            </Border>

            <UniformGrid x:Name="Cores" Columns="6" Margin="0,10,0,0" />

            <TextBlock x:Name="DicaCor" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="Desligar o acompanhamento" />

            <!-- Transparencia -->
            <TextBlock Text="Transparência" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Efeito de transparência" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock x:Name="DicaTransparencia" Text="Deixa o fundo aparecer atrás do painel" FontSize="11" Margin="0,2,40,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="Transparencia" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="Transparencia_Alterada" Unchecked="Transparencia_Alterada" />
                </Grid>
            </Border>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Opacidade do painel" FontSize="13" FontWeight="Medium"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                        <TextBlock x:Name="ValorOpacidade" Text="85%" FontSize="28" FontWeight="Light"
                                   FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="Opacidade" IsMoveToPointEnabled="True" Minimum="15" Maximum="100" Margin="0,10,0,0"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{DynamicResource Acento}"
                            ValueChanged="Opacidade_Alterada" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="15%" FontSize="11"
                                   Foreground="{DynamicResource TextoMuitoFraco}" HorizontalAlignment="Left" />
                        <TextBlock Text="100%" FontSize="11"
                                   Foreground="{DynamicResource TextoMuitoFraco}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource BotaoLargo}" Margin="0,20,0,0"
                    Content="Restaurar padrão" Click="Restaurar_Click" />

            </StackPanel>

            <!-- ======================== ABA KISLAND ======================== -->
            <!--
                Tudo da Kisland. Ela segue a cor e o tema do painel; o resto —
                opacidade, tamanho, o que mostra fechada e aberta, como abre,
                tela cheia, avisos e o guia — mora aqui.
            -->
            <StackPanel x:Name="AbaKisland" Visibility="Collapsed">
            <TextBlock x:Name="SecaoIlha" Text="Kisland" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                        <TextBlock Text="Mostrar a Kisland" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock Text="Inspirada na ilha flutuante dos novos iOS: visualização em tempo real de temperaturas, consumo, player de música e controle de volume, entre outras opções, tudo no topo da tela com acesso fácil e rápido. Vamos conhecer?"
                                   FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="IlhaAtiva" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                </Grid>
            </Border>

            <StackPanel x:Name="OpcoesIlha">

                <!-- Opacidade própria. Vale com a transparência ligada, na aba Painel. -->
                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Opacidade" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <TextBlock x:Name="ValorOpacidadeIlha" Text="85%" FontSize="28" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="OpacidadeIlha" IsMoveToPointEnabled="True" Minimum="15" Maximum="100" Margin="0,10,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Foreground="{DynamicResource Acento}"
                                ValueChanged="OpacidadeIlha_Alterada" />
                        <TextBlock x:Name="DicaOpacidadeIlha" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoMuitoFraco}" Visibility="Collapsed"
                                   Text="Ligue a transparência na aba Painel para ajustar." />
                    </StackPanel>
                </Border>

                <!-- Tamanho: só da Kisland, o painel não muda. -->
                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Tamanho" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <TextBlock x:Name="ValorEscalaIlha" Text="85%" FontSize="28" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="EscalaIlha" IsMoveToPointEnabled="True" Minimum="70" Maximum="100" Margin="0,10,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="5"
                                Foreground="{DynamicResource Acento}" ValueChanged="EscalaIlha_Alterada" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="70% · compacta" FontSize="11"
                                       Foreground="{DynamicResource TextoMuitoFraco}" HorizontalAlignment="Left" />
                            <TextBlock Text="100% · tamanho original" FontSize="11"
                                       Foreground="{DynamicResource TextoMuitoFraco}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    Telas OLED: a Kisland preta e a proteção contra marca. A
                    proteção vem ligada para todo mundo — em tela comum nenhum
                    dos três cuidados aparece, e em OLED são eles que evitam a
                    pílula ficar gravada no topo da tela.
                -->
                <TextBlock Text="Tela OLED" FontSize="11" Margin="0,12,0,8"
                           Foreground="{DynamicResource TextoFraco}" />

                <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                            <TextBlock Text="Kisland preta" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock Text="Fundo preto, sem borda nem sombra. Num AMOLED/OLED com fundo escuro, ela se funde com o topo da tela."
                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <CheckBox x:Name="IlhaPreta" Style="{StaticResource Interruptor}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                    </Grid>
                </Border>

                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                                <TextBlock Text="Proteger contra marca na tela" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="A Kisland fica sempre no mesmo lugar. Em telas OLED, isso pode marcar a tela com o tempo."
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaProteger" Style="{StaticResource Interruptor}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>

                        <Border Height="1" Margin="0,10,0,6" Background="{DynamicResource Borda}" />

                        <StackPanel x:Name="LinhasProtecao" Margin="12,0,0,0">
                            <Grid Margin="0,4">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                    <TextBlock Text="Proteção OLED" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Texto}" />
                                    <TextBlock Text="A cada 3 min ela anda 1 ou 2 px, de forma imperceptível."
                                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextoFraco}" />
                                </StackPanel>
                                <CheckBox x:Name="IlhaMexer" Style="{StaticResource CaixaDeSelecao}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                            </Grid>
                            <Grid Margin="0,4">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,100,0">
                                    <TextBlock Text="Escurecer sem uso" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Texto}" />
                                </StackPanel>
                                <ComboBox x:Name="IlhaEscurecer" Style="{StaticResource Seletor}" MinWidth="88"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          SelectionChanged="Ilha_Alterada" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Minimizada" FontSize="11" Margin="0,2,0,2"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <Grid Margin="0,4">
                            <TextBlock Text="Música tocando" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaMusica" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura da CPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaCpu" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso da CPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaCpuUso" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura da GPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaGpu" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso da GPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaGpuUso" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Volume" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaVolume" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso de RAM" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaRam" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura do disco" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaDisco" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Potência total" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaPotencia" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Relógio" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaRelogio" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Data (dia da semana e do mês)" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaData" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="FPS em jogos" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DetalheFps" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}"
                                           Text="Exibição em jogos" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaFps" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Botão de Personalização" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaBotaoPersonalizacao" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    Modo jogo: o jogo do contador de FPS em tela cheia no mesmo
                    monitor. Lista própria, separada da do dia a dia. Só vale
                    com o contador ligado: é ele que diz qual janela é o jogo.
                -->
                <Border x:Name="CartaoModoJogo" CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Exibição em jogos" FontSize="11" Margin="0,2,0,2"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <TextBlock x:Name="DicaModoJogo" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoMuitoFraco}"
                                   Text="Quando o jogo está em tela cheia no mesmo monitor que a Kisland. O FPS aparece sempre." />
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura da CPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaJogoCpu" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso da CPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaJogoCpuUso" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura da GPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaJogoGpu" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso da GPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaJogoGpuUso" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso de RAM" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaJogoRam" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Potência total" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaJogoPotencia" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Relógio" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaJogoRelogio" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Música tocando" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaJogoMusica" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- O que aparece com ela aberta. O rodapé fica sempre: é ele
                     que leva ao painel e de volta para cá. -->
                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Aberta, ela mostra" FontSize="11" Margin="0,2,0,6"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <Grid Margin="0,4">
                            <TextBlock Text="Player de música" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaPlayer" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Calendário do mês" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaCalendario" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura da CPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaCpu" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura da GPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaGpu" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="RAM" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaRam" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Disco" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaDisco" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Energia" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaEnergia" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Volume" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaVolume" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Trocar a saída de som" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Saídas de áudio disponíveis" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaSaidasDeSom" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Mixer de volume" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Volumes" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaMixer" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Modos de energia" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaPerfis" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Atalhos" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaAbertaAtalhos" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Bandeja de arquivos" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Arraste arquivos até a Kisland para deixá-los à mão. Ficam até você fechar o KInfo." FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaBandeja" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    Atalhos. O chat de IA mora no anel pulsante da Kisland
                    fechada; os apps e sites aparecem com ela aberta, junto do
                    chat. A lista é montada no código.
                -->
                <!--
                    Kdrop: a bandeja aberta para o celular e os outros PCs da
                    casa. Fica logo depois da bandeja, porque é parte dela, e
                    só vale com ela ligada.
                -->
                <TextBlock Text="Kdrop" FontSize="11" Margin="0,12,0,8"
                           Foreground="{DynamicResource TextoFraco}" />

                <Border x:Name="CartaoKdrop" CornerRadius="12" Background="{DynamicResource Cartao}"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                                <TextBlock Text="Compartilhamento de arquivos em rede local" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Celulares e outros PCs com KInfo, no mesmo Wi-Fi, mandam e pegam arquivos da bandeja. Todo envio pede o seu aceite."
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="KdropLigado" Style="{StaticResource Interruptor}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>

                        <StackPanel x:Name="LinhasKdrop" Margin="0,12,0,0">
                            <TextBlock Text="Nome deste PC na rede" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <Border CornerRadius="10" Background="{DynamicResource Chip}"
                                    BorderBrush="{DynamicResource Trilho}" BorderThickness="1" Padding="10,0">
                                <Grid>
                                    <TextBox x:Name="KdropNome" Height="34" BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" FontSize="12" MaxLength="40"
                                             Foreground="{DynamicResource Texto}" CaretBrush="{DynamicResource Texto}"
                                             TextChanged="Texto_Alterado" />
                                    <TextBlock x:Name="DicaKdropNome" FontSize="12" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Foreground="{DynamicResource TextoMuitoFraco}" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,92,0">
                                    <TextBlock Text="O que chegar fica em" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Texto}" />
                                    <TextBlock x:Name="KdropPasta" FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextoFraco}" />
                                </StackPanel>
                                <Button Style="{StaticResource BotaoLargo}" Width="84" Height="34"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Content="Alterar" Click="KdropPasta_Click" />
                            </Grid>

                            <TextBlock x:Name="KdropEndereco" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextoFraco}" />

                            <TextBlock Text="Aparelhos que aceitam sozinho" FontSize="12" Margin="0,14,0,4"
                                       Foreground="{DynamicResource TextoFraco}" />
                            <StackPanel x:Name="ListaConfiaveis" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Atalhos" FontSize="11" Margin="0,12,0,8"
                           Foreground="{DynamicResource TextoFraco}" />

                <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,132,0">
                                <TextBlock Text="Chat de IA no anel" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="O anel pulsante fica na Kisland e abre o chat com um clique."
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <ComboBox x:Name="IlhaIa" Style="{StaticResource Seletor}" MinWidth="124"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      SelectionChanged="Ia_Escolhida" />
                        </Grid>

                        <!-- App instalado: some com "Nenhum" e com "Outro". -->
                        <Grid x:Name="LinhaIaApp" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Abrir o app, se estiver instalado" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DicaIaApp" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}"
                                           Text="Sem o app no PC, abre o site." />
                            </StackPanel>
                            <CheckBox x:Name="IlhaIaApp" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>

                        <StackPanel x:Name="LinhaIaEndereco" Visibility="Collapsed" Margin="0,10,0,0">
                            <Border CornerRadius="10" Background="{DynamicResource Chip}"
                        BorderBrush="{DynamicResource Trilho}" BorderThickness="1" Padding="10,0">
                    <Grid>
                        <TextBox x:Name="IlhaIaEndereco" Height="34" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 Foreground="{DynamicResource Texto}" CaretBrush="{DynamicResource Texto}"
                                 TextChanged="Texto_Alterado" />
                        <TextBlock x:Name="DicaIaEndereco" Text="Endereço do chat, como meuchat.com" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                    </Grid>
                </Border>
                            <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextoMuitoFraco}"
                                       Text="Também vale o caminho de um app instalado." />
                        </StackPanel>

                        <Border Height="1" Margin="0,12,0,10" Background="{DynamicResource Borda}" />

                        <TextBlock Text="Apps e sites" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock x:Name="DicaAtalhos" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoFraco}"
                                   Text="Aparecem com a Kisland aberta, até 6." />

                        <StackPanel x:Name="ListaAtalhos" Margin="0,6,0,0" />

                        <!-- Site novo: nome e endereço, e só então entra na lista. -->
                        <StackPanel x:Name="NovoSite" Visibility="Collapsed" Margin="0,8,0,0">
                            <Border CornerRadius="10" Background="{DynamicResource Chip}"
                        BorderBrush="{DynamicResource Trilho}" BorderThickness="1" Padding="10,0">
                    <Grid>
                        <TextBox x:Name="EnderecoDoSite" Height="34" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 Foreground="{DynamicResource Texto}" CaretBrush="{DynamicResource Texto}"
                                 TextChanged="Texto_Alterado" />
                        <TextBlock x:Name="DicaEnderecoDoSite" Text="Endereço, como youtube.com" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                    </Grid>
                </Border>
                            <Border CornerRadius="10" Background="{DynamicResource Chip}" Margin="0,6,0,0"
                        BorderBrush="{DynamicResource Trilho}" BorderThickness="1" Padding="10,0">
                    <Grid>
                        <TextBox x:Name="NomeDoSite" Height="34" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 Foreground="{DynamicResource Texto}" CaretBrush="{DynamicResource Texto}"
                                 TextChanged="Texto_Alterado" />
                        <TextBlock x:Name="DicaNomeDoSite" Text="Nome (opcional)" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                    </Grid>
                </Border>
                            <TextBlock x:Name="ErroDoSite" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource AvisoIcone}" Text="Esse endereço não parece um site." />
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource BotaoLargo}" Height="36" Margin="0,0,4,0"
                                        Content="Cancelar" Click="CancelarSite_Click" />
                                <Button Style="{StaticResource BotaoLargo}" Height="36" Margin="4,0,0,0"
                                        Content="Adicionar" Click="ConfirmarSite_Click" />
                            </UniformGrid>
                        </StackPanel>

                        <UniformGrid x:Name="BotoesAtalho" Columns="2" Margin="0,10,0,0">
                            <Button Style="{StaticResource BotaoLargo}" Height="36" Margin="0,0,4,0"
                                    Content="Adicionar app" Click="AdicionarApp_Click" />
                            <Button Style="{StaticResource BotaoLargo}" Height="36" Margin="4,0,0,0"
                                    Content="Adicionar site" Click="AdicionarSite_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Abrir a Kisland" FontSize="11" Margin="0,12,0,8"
                           Foreground="{DynamicResource TextoFraco}" />

                <Border CornerRadius="14" Background="{DynamicResource Cartao}"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="4">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="IlhaAoPassar" Style="{StaticResource Aba}" GroupName="AberturaDaIlha"
                                     Content="Ao passar o mouse" Checked="Ilha_Alterada" />
                        <RadioButton x:Name="IlhaAoClicar" Style="{StaticResource Aba}" GroupName="AberturaDaIlha"
                                     Content="Ao clicar" Checked="Ilha_Alterada" />
                    </UniformGrid>
                </Border>

                <!-- Quanto o mouse precisa ficar em cima. Só vale abrindo ao
                     passar o mouse. -->
                <Border x:Name="CartaoEspera" CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,100,0">
                            <TextBlock Text="Esperar antes de abrir" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock Text="Tempo até abertura da Kisland"
                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <ComboBox x:Name="IlhaEspera" Style="{StaticResource Seletor}" MinWidth="88"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectionChanged="Ilha_Alterada" />
                    </Grid>
                </Border>

                <!--
                    Tela cheia num cartão só: a regra (esconder) e a exceção a
                    ela (o FPS do jogo). A exceção fica logo abaixo, recuada,
                    e só vale com a regra ligada e o contador de FPS ligado.
                -->
                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                                <TextBlock Text="Esconder em tela cheia" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Jogos, vídeos e apresentações ficam sem nada por cima"
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaTelaCheia" Style="{StaticResource Interruptor}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>

                        <Border Height="1" Margin="0,10,0,10" Background="{DynamicResource Borda}" />

                        <Grid x:Name="LinhaFpsTelaCheia" Margin="12,0,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Menos o FPS dos jogos" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DetalheTelaCheia" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}"
                                           Text="Com o contador ligado, o FPS fica por cima de jogos sem borda. Marcando, ela tenta também na tela cheia exclusiva: experimental." />
                            </StackPanel>
                            <CheckBox x:Name="IlhaFicarEmTelaCheia" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                            <TextBlock Text="Roda do mouse muda o volume" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock Text="Com o mouse em cima da Kisland, cada giro muda 2%. O clique da roda pausa ou volta a música."
                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                        <CheckBox x:Name="IlhaRodaVolume" Style="{StaticResource Interruptor}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                    </Grid>
                </Border>

                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Avisos rápidos" FontSize="11" Margin="0,2,0,6"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Volume ao mudar" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Por 2 s. O aviso do Windows continua aparecendo."
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaAvisoVolume" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Música nova" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Por 3 s, quando a faixa troca."
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaAvisoFaixa" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextoMuitoFraco}"
                           Text="A Kisland segue a cor e o tema escolhidos na aba Painel." />
            </StackPanel>

            <!-- Fora do bloco de opções, que fica apagado com a Kisland
                 desligada: o guia serve justamente a quem ainda não ligou. -->
            <Button Style="{StaticResource BotaoLargo}" Margin="0,12,0,0"
                    Content="Ver o guia da Kisland" Click="GuiaKisland_Click" />

            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
