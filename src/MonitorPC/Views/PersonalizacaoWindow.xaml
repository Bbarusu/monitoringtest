<Window x:Class="MonitorPC.Views.PersonalizacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalização"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <!--
            Rolagem para tela baixa. Esta janela cresce com o conteúdo, e num
            notebook o conteúdo passa da altura útil; Janelas.LimitarAltura põe
            o teto, e sem rolagem o teto cortaria em vez de passar da tela —
            troca de um problema por outro. Aqui o conteúdo rola inteiro,
            botões incluídos: são poucas linhas e todas alcançáveis.
        -->
        <ScrollViewer x:Name="Rolagem" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Conteudo">

            <!-- Cabecalho -->
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Personalização" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock Text="Cor, transparência e Kisland" FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <!-- Tema -->
            <TextBlock Text="Tema" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="14" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="4">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="TemaEscuro" Style="{StaticResource Aba}" Content="Escuro"
                                 Checked="Tema_Alterado" />
                    <RadioButton x:Name="TemaClaro" Style="{StaticResource Aba}" Content="Claro"
                                 Checked="Tema_Alterado" />
                    <RadioButton x:Name="TemaSistema" Style="{StaticResource Aba}" Content="Sistema"
                                 Checked="Tema_Alterado" />
                </UniformGrid>
            </Border>

            <!-- Cor de destaque -->
            <TextBlock Text="Cor de destaque" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Acompanhar a cor do sistema" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock Text="Usa a cor de destaque do Windows, e o tema junto" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="SeguirSistema" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="SeguirSistema_Alterado" Unchecked="SeguirSistema_Alterado" />
                </Grid>
            </Border>

            <UniformGrid x:Name="Cores" Columns="6" Margin="0,10,0,0" />

            <TextBlock x:Name="DicaCor" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="Desligue o acompanhamento para escolher uma cor." />

            <!-- Transparencia -->
            <TextBlock Text="Transparência" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Efeito de transparência" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock Text="Deixa o fundo aparecer atrás do painel" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="Transparencia" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="Transparencia_Alterada" Unchecked="Transparencia_Alterada" />
                </Grid>
            </Border>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Opacidade do painel" FontSize="13" FontWeight="Medium"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                        <TextBlock x:Name="ValorOpacidade" Text="85%" FontSize="28" FontWeight="Light"
                                   FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="Opacidade" IsMoveToPointEnabled="True" Minimum="15" Maximum="100" Margin="0,10,0,0"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{DynamicResource Acento}"
                            ValueChanged="Opacidade_Alterada" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="15% · quase invisível" FontSize="11"
                                   Foreground="{DynamicResource TextoMuitoFraco}" HorizontalAlignment="Left" />
                        <TextBlock Text="100% · sólido" FontSize="11"
                                   Foreground="{DynamicResource TextoMuitoFraco}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--
                Ilha no topo da tela. Fica aqui, e não em Ajustes, porque é
                aparência: ela não tem cor, tema nem transparência próprios —
                segue o que está escolhido acima, e mexer lá repinta as duas.
            -->
            <TextBlock x:Name="SecaoIlha" Text="Kisland" FontSize="11" Margin="0,20,0,8"
                       Foreground="{DynamicResource TextoFraco}" />

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                        <TextBlock Text="Mostrar a Kisland" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Texto}" />
                        <TextBlock Text="Inspirada nos iPhones mais novos: música, temperatura e volume no topo da tela. Passe o mouse para abrir; arraste para levar a outro monitor."
                                   FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoFraco}" />
                    </StackPanel>
                    <CheckBox x:Name="IlhaAtiva" Style="{StaticResource Interruptor}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                </Grid>
            </Border>

            <StackPanel x:Name="OpcoesIlha">

                <!-- Tamanho: só da Kisland, o painel não muda. -->
                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Tamanho" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <TextBlock x:Name="ValorEscalaIlha" Text="85%" FontSize="28" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="EscalaIlha" IsMoveToPointEnabled="True" Minimum="70" Maximum="100" Margin="0,10,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="5"
                                Foreground="{DynamicResource Acento}" ValueChanged="EscalaIlha_Alterada" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="70% · compacta" FontSize="11"
                                       Foreground="{DynamicResource TextoMuitoFraco}" HorizontalAlignment="Left" />
                            <TextBlock Text="100% · tamanho original" FontSize="11"
                                       Foreground="{DynamicResource TextoMuitoFraco}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>


                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="O que aparece" FontSize="11" Margin="0,2,0,2"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <TextBlock Text="Sem nada marcado e nada tocando, ela vira um círculo."
                                   FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoMuitoFraco}" />
                        <Grid Margin="0,4">
                            <TextBlock Text="Música tocando" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaMusica" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura da CPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaCpu" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso da CPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaCpuUso" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura da GPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaGpu" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso da GPU" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaGpuUso" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Volume" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaVolume" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Uso de RAM" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaRam" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Temperatura do disco" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaDisco" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Potência total" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaPotencia" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Relógio" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaRelogio" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="FPS em jogos" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DetalheFps" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}"
                                           Text="Aparece quando um jogo está rodando, em qualquer monitor. Em tela cheia sem borda, a Kisland fica só com o FPS." />
                            </StackPanel>
                            <CheckBox x:Name="IlhaFps" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Botão de Personalização" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                            <CheckBox x:Name="IlhaBotaoPersonalizacao" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Abrir a Kisland" FontSize="11" Margin="0,12,0,8"
                           Foreground="{DynamicResource TextoFraco}" />

                <Border CornerRadius="14" Background="{DynamicResource Cartao}"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="4">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="IlhaAoPassar" Style="{StaticResource Aba}" GroupName="AberturaDaIlha"
                                     Content="Ao passar o mouse" Checked="Ilha_Alterada" />
                        <RadioButton x:Name="IlhaAoClicar" Style="{StaticResource Aba}" GroupName="AberturaDaIlha"
                                     Content="Ao clicar" Checked="Ilha_Alterada" />
                    </UniformGrid>
                </Border>

                <!--
                    Tela cheia num cartão só: a regra (esconder) e a exceção a
                    ela (o FPS do jogo). A exceção fica logo abaixo, recuada,
                    e só vale com a regra ligada e o contador de FPS ligado.
                -->
                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,52,0">
                                <TextBlock Text="Esconder em tela cheia" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Jogos, vídeos e apresentações ficam sem nada por cima"
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaTelaCheia" Style="{StaticResource Interruptor}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>

                        <Border Height="1" Margin="0,10,0,10" Background="{DynamicResource Borda}" />

                        <Grid x:Name="LinhaFpsTelaCheia" Margin="12,0,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Menos o FPS dos jogos" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DetalheTelaCheia" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}"
                                           Text="Com o contador ligado, o FPS fica por cima de jogos sem borda. Marcando, ela tenta também na tela cheia exclusiva: experimental, pode não aparecer, e em alguns jogos a tela pisca." />
                            </StackPanel>
                            <CheckBox x:Name="IlhaFicarEmTelaCheia" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" Background="{DynamicResource Cartao}" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Avisos rápidos" FontSize="11" Margin="0,2,0,6"
                                   Foreground="{DynamicResource TextoFraco}" />
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Volume ao mudar" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Por 2 s. O aviso do Windows continua aparecendo."
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaAvisoVolume" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                        <Grid Margin="0,4">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                                <TextBlock Text="Música nova" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="Por 3 s, quando a faixa troca."
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <CheckBox x:Name="IlhaAvisoFaixa" Style="{StaticResource CaixaDeSelecao}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Ilha_Alterada" Unchecked="Ilha_Alterada" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextoMuitoFraco}"
                           Text="A Kisland segue a cor, o tema e a transparência escolhidos acima." />
            </StackPanel>

            <!-- Fora do bloco de opções, que fica apagado com a Kisland
                 desligada: o guia serve justamente a quem ainda não ligou. -->
            <Button Style="{StaticResource BotaoLargo}" Margin="0,12,0,0"
                    Content="Ver o guia da Kisland" Click="GuiaKisland_Click" />

            <Button Style="{StaticResource BotaoLargo}" Margin="0,20,0,0"
                    Content="Restaurar padrão" Click="Restaurar_Click" />

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
