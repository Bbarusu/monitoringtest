<Window x:Class="MonitorPC.Views.IlhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KInfo — Kisland"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource FonteUI}">

    <!--
        A ilha do topo da tela. Mesma paleta, mesmos cartões e mesmos botões do
        painel: é o painel em tamanho de bolso, não um app à parte.

        Quatro estados, um visível por vez: a pílula (Compacta), os dois avisos
        rápidos (volume e troca de faixa) e a ilha aberta (Expandida). A janela
        tem SizeToContent e se recentraliza a cada mudança de tamanho, então a
        troca de estado é só trocar o que está visível.

        As margens da Casca são o espaço da sombra. A janela é transparente ali,
        e pixel transparente não recebe clique: a área em volta da ilha continua
        sendo do que estiver atrás.
    -->

    <Window.Resources>
        <Style x:Key="ChipIlha" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Chip}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Trilho}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TextoChip" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="IconeChip" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextoFraco}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BarraEqualizador" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Fill" Value="{DynamicResource Acento}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
        </Style>
        <!-- Botao redondo pequeno, para o mudo e a Personalizacao na pilula:
             o quadrado de cantos 10 do rodape do painel destoava dentro de uma
             ilha toda arredondada. -->
        <Style x:Key="BotaoRedondoPequeno" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="18" Background="{DynamicResource Chip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Trilho}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Botao sem moldura: o desenho e o proprio conteudo. Usado no anel
             (quando ha um chat de IA escolhido) e nas saidas de som. -->
        <Style x:Key="BotaoSemMoldura" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Atalho da Kisland aberta: icone redondo e o nome embaixo. -->
        <Style x:Key="BotaoAtalho" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Padding="2,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Chip}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Barra de volume no desenho da Kisland: trilho fino de 6 px, a
             parte cheia na cor de destaque e uma bolinha branca, como no
             canvas. O Slider padrao do Windows destoava do resto. -->
        <Style x:Key="TrechoCheio" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource Acento}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrechoVazio" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BolinhaIlha" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="14" Height="14" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="Black" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderIlha" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource Trilho}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrechoCheio}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrechoVazio}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource BolinhaIlha}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Botao de acao principal (Aceitar do Kdrop): cheio, na cor de destaque. -->
        <Style x:Key="BotaoPrincipalIlha" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12" Background="{DynamicResource Acento}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniCartao" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource Cartao}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border x:Name="Casca" Margin="16,6,16,28" CornerRadius="22"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1"
            PreviewMouseLeftButtonDown="Casca_Pressionada">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.36" Color="Black" />
        </Border.Effect>

        <Grid>

            <!-- ========================= PÍLULA ========================= -->
            <StackPanel x:Name="Compacta" Orientation="Horizontal" Height="44" Margin="6,0,8,0">

                <!--
                    O anel. Aparece sozinho quando não há nada para mostrar, e a
                    pílula vira um círculo com ele dentro. Com um chat de IA
                    escolhido na Personalização, fica sempre aqui, no começo, e
                    um clique nele abre o chat. Sem chat, não é clicável: o
                    clique passa para a Kisland, que abre.
                -->
                <Button x:Name="BotaoAnel" Style="{StaticResource BotaoSemMoldura}" VerticalAlignment="Center"
                        Visibility="Collapsed" IsHitTestVisible="False" Click="Anel_Click">
                    <Grid x:Name="SemItens" Width="32" Height="32">
                        <Ellipse Width="30" Height="30" Stroke="{DynamicResource Acento}"
                                 StrokeThickness="1" Opacity="0.28" />
                        <Ellipse x:Name="Anel" Width="21" Height="21" Stroke="{DynamicResource Acento}"
                                 StrokeThickness="3.5" RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                </Button>

                <StackPanel x:Name="MidiaCompacta" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,4,0" Visibility="Collapsed">
                    <Border x:Name="CapaPequena" Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource Chip}">
                        <Path x:Name="NotaPequena" Data="M9,18 L9,5 L21,3 L21,16 M9,18 A3,3 0 1,1 3,18 A3,3 0 1,1 9,18 M21,16 A3,3 0 1,1 15,16 A3,3 0 1,1 21,16"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Border>
                    <Grid Height="16" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel x:Name="Equalizador" Orientation="Horizontal">
                            <Rectangle Style="{StaticResource BarraEqualizador}" Height="7" />
                            <Rectangle Style="{StaticResource BarraEqualizador}" Height="16" />
                            <Rectangle Style="{StaticResource BarraEqualizador}" Height="10" />
                            <Rectangle Style="{StaticResource BarraEqualizador}" Height="13" Margin="0" />
                        </StackPanel>
                        <Path x:Name="PausadoPequeno" Data="M8,5 L8,19 M16,5 L16,19" Visibility="Collapsed"
                              Stroke="{DynamicResource TextoFraco}" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform" />
                    </Grid>
                </StackPanel>

                <!-- Aviso de temperatura: some quando o limite volta a ser respeitado. -->
                <Border x:Name="ChipAlerta" Style="{StaticResource ChipIlha}" Visibility="Collapsed"
                        Background="{DynamicResource AvisoChip}" BorderBrush="{DynamicResource AvisoBorda}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconeChip}" Stroke="{DynamicResource AvisoIcone}"
                              Data="M12,3 L22,21 L2,21 Z M12,10 L12,15 M12,18 L12.01,18" />
                        <TextBlock x:Name="TextoAlerta" Style="{StaticResource TextoChip}"
                                   Foreground="{DynamicResource AvisoIcone}" />
                    </StackPanel>
                </Border>

                <!-- FPS do jogo rodando, em qualquer monitor. Só existe com um
                     jogo aberto e o contador ligado. -->
                <Border x:Name="ChipFps" Style="{StaticResource ChipIlha}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconeChip}" Stroke="{DynamicResource Acento}"
                              Data="M6,9 L18,9 A4,4 0 0,1 22,13 L22,15 A3,3 0 0,1 16.5,16.5 L15,15 L9,15 L7.5,16.5 A3,3 0 0,1 2,15 L2,13 A4,4 0 0,1 6,9 Z M7,11 L7,13 M6,12 L8,12 M16,12 L16.01,12 M18,12 L18.01,12" />
                        <TextBlock x:Name="TextoFps" Style="{StaticResource TextoChip}" Text="-- FPS" />
                    </StackPanel>
                </Border>

                <Border x:Name="ChipCpu" Style="{StaticResource ChipIlha}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconeChip}"
                              Data="M14,14.8 L14,4 A2,2 0 1,0 10,4 L10,14.8 A4,4 0 1,0 14,14.8 Z" />
                        <TextBlock x:Name="TextoCpu" Style="{StaticResource TextoChip}" Text="CPU --" />
                    </StackPanel>
                </Border>

                <Border x:Name="ChipGpu" Style="{StaticResource ChipIlha}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconeChip}"
                              Data="M5,6 L19,6 A2,2 0 0,1 21,8 L21,16 A2,2 0 0,1 19,18 L5,18 A2,2 0 0,1 3,16 L3,8 A2,2 0 0,1 5,6 Z M7,10 L11,10" />
                        <TextBlock x:Name="TextoGpu" Style="{StaticResource TextoChip}" Text="GPU --" />
                    </StackPanel>
                </Border>

                <Border x:Name="ChipRam" Style="{StaticResource ChipIlha}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconeChip}"
                              Data="M4,8 L20,8 A1,1 0 0,1 21,9 L21,15 A1,1 0 0,1 20,16 L4,16 A1,1 0 0,1 3,15 L3,9 A1,1 0 0,1 4,8 Z M7,16 L7,19 M12,16 L12,19 M17,16 L17,19" />
                        <TextBlock x:Name="TextoRam" Style="{StaticResource TextoChip}" Text="RAM --" />
                    </StackPanel>
                </Border>

                <Border x:Name="ChipDisco" Style="{StaticResource ChipIlha}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconeChip}"
                              Data="M5,5 L19,5 A2,2 0 0,1 21,7 L21,17 A2,2 0 0,1 19,19 L5,19 A2,2 0 0,1 3,17 L3,7 A2,2 0 0,1 5,5 Z M7,15 L7.01,15 M11,15 L17,15" />
                        <TextBlock x:Name="TextoDisco" Style="{StaticResource TextoChip}" Text="Disco --" />
                    </StackPanel>
                </Border>

                <Border x:Name="ChipPotencia" Style="{StaticResource ChipIlha}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconeChip}" Data="M13,2 L4,14 L11,14 L10,22 L19,10 L12,10 Z" />
                        <TextBlock x:Name="TextoPotencia" Style="{StaticResource TextoChip}" Text="-- W" />
                    </StackPanel>
                </Border>

                <Border x:Name="ChipVolume" Style="{StaticResource ChipIlha}">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="IconeVolumeChip" Style="{StaticResource IconeChip}" StrokeThickness="1.6" />
                        <TextBlock x:Name="TextoVolume" Style="{StaticResource TextoChip}" Text="--" />
                    </StackPanel>
                </Border>

                <!-- Data e hora no mesmo chip, como na tela de espera do iPhone:
                     a data na cor de destaque, a hora logo depois. -->
                <Border x:Name="ChipRelogio" Style="{StaticResource ChipIlha}">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="IconeRelogio" Style="{StaticResource IconeChip}"
                              Data="M12,3 A9,9 0 1,1 11.99,3 Z M12,7 L12,12 L15,14" />
                        <TextBlock x:Name="TextoData" Style="{StaticResource TextoChip}"
                                   Foreground="{DynamicResource Acento}" Text="--" />
                        <TextBlock x:Name="TextoRelogio" Style="{StaticResource TextoChip}" Text="--:--" />
                    </StackPanel>
                </Border>

                <!-- Arquivos na bandeja: so aparece com algum guardado. -->
                <Border x:Name="ChipBandeja" Style="{StaticResource ChipIlha}" Visibility="Collapsed"
                        ToolTip="Arquivos na bandeja">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconeChip}" StrokeThickness="1.8"
                              Data="M4,13 L7,5 L17,5 L20,13 L20,18 A2,2 0 0,1 18,20 L6,20 A2,2 0 0,1 4,18 Z M4,13 L9,13 L10,15 L14,15 L15,13 L20,13" />
                        <TextBlock x:Name="TextoBandeja" Style="{StaticResource TextoChip}" Text="0" />
                    </StackPanel>
                </Border>

                <Button x:Name="BotaoPersonalizarPilula" Style="{StaticResource BotaoRedondoPequeno}"
                        Width="30" Height="30" Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip="Personalização" Click="Personalizar_Click">
                    <Path Data="M12,3 A9,9 0 1,0 12,21 A2,2 0 0,0 14,19 C14,18 13,17.5 13,16.5 C13,15.5 13.7,15 15,15 L17,15 A3,3 0 0,0 20,12 C20,7 16,3 12,3 Z"
                          Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          Width="13" Height="13" Stretch="Uniform" />
                </Button>

            </StackPanel>

            <!-- ===================== AVISO: VOLUME ====================== -->
            <StackPanel x:Name="AvisoVolume" Orientation="Horizontal" Height="44" Margin="6,0,16,0"
                        Visibility="Collapsed">
                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Chip}">
                    <Path x:Name="IconeAvisoVolume" Stroke="{DynamicResource Icone}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="15" Height="15" Stretch="Uniform" />
                </Border>
                <Grid Width="160" Height="6" Margin="12,0,12,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="AvisoVolumeCheio" Width="1*" />
                        <ColumnDefinition x:Name="AvisoVolumeVazio" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource Trilho}" />
                    <Border CornerRadius="3" Background="{DynamicResource Acento}" />
                </Grid>
                <TextBlock x:Name="ValorAvisoVolume" Text="--" FontSize="22" FontWeight="Light"
                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                           VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" />
            </StackPanel>

            <!-- ================= AVISO: TROCA DE FAIXA ================== -->
            <StackPanel x:Name="AvisoFaixa" Orientation="Horizontal" Height="56" Margin="6,0,18,0"
                        Visibility="Collapsed">
                <Border x:Name="CapaAviso" Width="44" Height="44" CornerRadius="22"
                        Background="{DynamicResource Chip}">
                    <Path x:Name="NotaAviso" Data="M9,18 L9,5 L21,3 L21,16 M9,18 A3,3 0 1,1 3,18 A3,3 0 1,1 9,18 M21,16 A3,3 0 1,1 15,16 A3,3 0 1,1 21,16"
                          Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          Width="18" Height="18" Stretch="Uniform" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="240">
                    <TextBlock x:Name="TituloAviso" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistaAviso" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextoFraco}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- ======================= ILHA ABERTA ====================== -->
            <StackPanel x:Name="Expandida" Width="480" Margin="20" Visibility="Collapsed">

                <!-- Tocando agora -->
                <Grid x:Name="BlocoMidia">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CapaGrande" Width="72" Height="72" CornerRadius="12"
                            Background="{DynamicResource Chip}">
                        <Path x:Name="NotaGrande" Data="M9,18 L9,5 L21,3 L21,16 M9,18 A3,3 0 1,1 3,18 A3,3 0 1,1 9,18 M21,16 A3,3 0 1,1 15,16 A3,3 0 1,1 21,16"
                              Stroke="{DynamicResource Icone}" StrokeThickness="1.6"
                              Width="28" Height="28" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppMidia" FontSize="11" Foreground="{DynamicResource TextoFraco}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TituloMidia" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Texto}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistaMidia" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextoFraco}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BotaoRedondoFraco}" ToolTip="Anterior" Click="Anterior_Click">
                            <Path Data="M19,20 L9,12 L19,4 Z M5,19 L5,5" Stroke="{DynamicResource Icone}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BotaoTocar" Style="{StaticResource BotaoRedondo}" Margin="8,0,8,0"
                                ToolTip="Tocar ou pausar" Click="TocarPausar_Click">
                            <Path x:Name="IconeTocar" Fill="White" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource BotaoRedondoFraco}" ToolTip="Próxima" Click="Proxima_Click">
                            <Path Data="M5,4 L15,12 L5,20 Z M19,5 L19,19" Stroke="{DynamicResource Icone}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="BlocoProgresso" Margin="0,14,0,0">
                    <Grid Height="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ProgressoFeito" Width="0*" />
                            <ColumnDefinition x:Name="ProgressoFalta" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource Trilho}" />
                        <Border CornerRadius="3" Background="{DynamicResource Acento}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="TempoAtual" FontSize="11" Foreground="{DynamicResource TextoFraco}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="TempoTotal" FontSize="11" Foreground="{DynamicResource TextoFraco}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Border x:Name="SemMidia" CornerRadius="12" Padding="12" Visibility="Collapsed"
                        Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Chip}">
                            <Path Data="M9,18 L9,5 L21,3 L21,16 M9,18 A3,3 0 1,1 3,18 A3,3 0 1,1 9,18 M21,16 A3,3 0 1,1 15,16 A3,3 0 1,1 21,16"
                                  Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Nada tocando agora" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Texto}" />
                            <TextBlock Text="Spotify, YouTube e outros players aparecem aqui" FontSize="11"
                                       Margin="0,2,0,0" Foreground="{DynamicResource TextoFraco}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--
                    Calendário do mês, no jeito do widget da tela de espera do
                    iPhone: à esquerda o mês, o dia da semana e o dia grande; à
                    direita o mês inteiro, com hoje marcado na cor de destaque.
                    Os dias são montados no código, e refeitos na virada do dia.
                -->
                <Border x:Name="BlocoCalendario" Margin="0,16,0,0" CornerRadius="12" Padding="16,14"
                        Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock x:Name="MesCalendario" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextoFraco}" />
                                <TextBlock x:Name="SemanaCalendario" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Acento}" />
                                <TextBlock x:Name="AnoCalendario" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                            <TextBlock x:Name="DiaCalendario" FontSize="52" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,-6" />
                        </Grid>

                        <Grid x:Name="GradeCalendario" Grid.Column="1" />
                    </Grid>
                </Border>

                <!-- Temperaturas -->
                <UniformGrid x:Name="GradeTemperaturas" Columns="2" Margin="0,16,0,0">
                    <Border x:Name="CartaoCpu" Margin="0,0,6,0" CornerRadius="12" Padding="12"
                            Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="RotuloCpu" Text="CPU" FontSize="11" Foreground="{DynamicResource TextoFraco}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="ValorCpu" Text="--" FontSize="34" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="°C" FontSize="13" Margin="3,5,0,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CartaoGpu" Margin="6,0,0,0" CornerRadius="12" Padding="12"
                            Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="RotuloGpu" Text="GPU" FontSize="11" Foreground="{DynamicResource TextoFraco}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="ValorGpu" Text="--" FontSize="34" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="°C" FontSize="13" Margin="3,5,0,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Memoria, disco e energia -->
                <UniformGrid x:Name="GradeSistema" Columns="3" Margin="0,12,0,0">
                    <Border x:Name="CartaoRam" Style="{StaticResource MiniCartao}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock x:Name="RotuloRam" Text="RAM" FontSize="11"
                                       Foreground="{DynamicResource TextoFraco}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="ValorRam" Text="--" FontSize="24" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="%" FontSize="12" Margin="3,4,0,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CartaoDisco" Style="{StaticResource MiniCartao}" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Disco" FontSize="11" Foreground="{DynamicResource TextoFraco}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="ValorDisco" Text="--" FontSize="24" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="°C" FontSize="12" Margin="3,4,0,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CartaoEnergia" Style="{StaticResource MiniCartao}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Energia" FontSize="11" Foreground="{DynamicResource TextoFraco}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="ValorPotencia" Text="--" FontSize="24" FontWeight="Light"
                                           FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}" />
                                <TextBlock Text="W" FontSize="12" Margin="3,4,0,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextoFraco}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Volume -->
                <Border x:Name="BlocoVolume" Margin="0,12,0,0" CornerRadius="12" Padding="12"
                        Background="{DynamicResource Cartao}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BotaoRedondoPequeno}" ToolTip="Silenciar ou voltar o som"
                                        Click="Mudo_Click">
                                    <Path x:Name="IconeMudo" Stroke="{DynamicResource Icone}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="16" Height="16" Stretch="Uniform" />
                                </Button>
                                <TextBlock Text="Volume" FontSize="13" FontWeight="Medium" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                <!-- Mixer: o volume de cada app, como o do Windows. -->
                                <Button x:Name="BotaoMixer" Style="{StaticResource BotaoRedondoPequeno}" Width="28" Height="28"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip="Mixer: o volume de cada app" Click="Mixer_Click">
                                    <Path x:Name="IconeMixer"
                                          Data="M6,4 L6,20 M12,4 L12,20 M18,4 L18,20 M4,14 L8,14 M10,8 L14,8 M16,16 L20,16"
                                          Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="ValorVolume" Text="--" FontSize="28" FontWeight="Light"
                                       FontFamily="{StaticResource FonteNumero}" Foreground="{DynamicResource Texto}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="SliderVolume" Style="{StaticResource SliderIlha}" Minimum="0" Maximum="100" Margin="0,10,0,0"
                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="SliderVolume_Alterado" />

                        <!--
                            Mixer: uma linha por app com som na saída atual —
                            ícone (toque silencia só ele), nome, controle e
                            porcentagem. Montado no código; lido de novo a cada
                            2 s enquanto aberto, para acompanhar o mixer do
                            Windows.
                        -->
                        <StackPanel x:Name="MixerDeSom" Visibility="Collapsed" Margin="0,12,0,0">
                            <Border Height="1" Margin="0,0,0,4" Background="{DynamicResource Borda}" />
                            <StackPanel x:Name="AppsDoMixer" />
                            <TextBlock x:Name="MixerVazio" Visibility="Collapsed" FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"
                                       Text="Nenhum app usando o som agora." />
                        </StackPanel>

                        <!-- Saídas de som ativas, com a atual marcada. Só com mais
                             de uma: com uma só não há o que trocar. -->
                        <WrapPanel x:Name="SaidasDeSom" Margin="0,12,0,-6" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Perfis de energia, os mesmos do painel -->
                <UniformGrid x:Name="GradePerfis" Columns="3" Margin="0,12,0,0">
                    <RadioButton x:Name="PerfilEconomico" Style="{StaticResource Perfil}" GroupName="PerfilDaIlha"
                                 Content="Econômico" Margin="0,0,6,0" Click="Perfil_Click" />
                    <RadioButton x:Name="PerfilEquilibrado" Style="{StaticResource Perfil}" GroupName="PerfilDaIlha"
                                 Content="Equilibrado" Margin="6,0,6,0" Click="Perfil_Click" />
                    <RadioButton x:Name="PerfilDesempenho" Style="{StaticResource Perfil}" GroupName="PerfilDaIlha"
                                 Content="Desempenho" Margin="6,0,0,0" Click="Perfil_Click" />
                </UniformGrid>

                <!-- Atalhos: o chat de IA e os apps e sites escolhidos na
                     Personalização. Montados no código. -->
                <Border x:Name="BlocoAtalhos" Style="{StaticResource MiniCartao}" Margin="0,12,0,0" Padding="6,4">
                    <UniformGrid x:Name="GradeAtalhos" Rows="1" />
                </Border>

                <!--
                    Bandeja: arquivos arrastados até a Kisland, à mão até serem
                    usados. Clique abre, arrastar leva para outro lugar, e o
                    botão de copiar põe todos na área de transferência, para
                    colar com Ctrl+V numa pasta.
                -->
                <Border x:Name="BlocoBandeja" Style="{StaticResource MiniCartao}" Margin="0,12,0,0" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M4,13 L7,5 L17,5 L20,13 L20,18 A2,2 0 0,1 18,20 L6,20 A2,2 0 0,1 4,18 Z M4,13 L9,13 L10,15 L14,15 L15,13 L20,13"
                                      Stroke="{DynamicResource Icone}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock x:Name="TituloBandeja" Text="Bandeja" FontSize="12" FontWeight="Medium"
                                           Margin="8,0,0,0" Foreground="{DynamicResource Texto}" />
                            </StackPanel>
                            <StackPanel x:Name="AcoesBandeja" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BotaoRedondoPequeno}" Width="30" Height="30"
                                        ToolTip="Copiar todos (cole com Ctrl+V numa pasta)" Click="CopiarBandeja_Click">
                                    <Path Data="M9,9 L19,9 A2,2 0 0,1 21,11 L21,19 A2,2 0 0,1 19,21 L11,21 A2,2 0 0,1 9,19 Z M5,15 A2,2 0 0,1 3,13 L3,5 A2,2 0 0,1 5,3 L13,3 A2,2 0 0,1 15,5"
                                          Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource BotaoRedondoPequeno}" Width="30" Height="30" Margin="6,0,0,0"
                                        ToolTip="Esvaziar a bandeja (os arquivos continuam onde estão)" Click="LimparBandeja_Click">
                                    <Path Data="M4,7 L20,7 M10,11 L10,17 M14,11 L14,17 M6,7 L7,19 A2,2 0 0,0 9,21 L15,21 A2,2 0 0,0 17,19 L18,7 M9,7 L9,4 A1,1 0 0,1 10,3 L14,3 A1,1 0 0,1 15,4 L15,7"
                                          Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!--
                            Kdrop: um pedido chegando. Fica no topo da bandeja,
                            na cor de destaque, até ser respondido ou o prazo
                            acabar; enquanto isso a Kisland mostra só a bandeja.
                        -->
                        <Border x:Name="PedidoKdrop" Visibility="Collapsed" Margin="0,10,0,0" CornerRadius="12" Padding="12"
                                Background="{DynamicResource InfoFundo}" BorderBrush="{DynamicResource Acento}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Chip}" VerticalAlignment="Top">
                                        <Path x:Name="IconePedidoKdrop" Stroke="{DynamicResource Icone}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Kdrop" FontSize="11" Foreground="{DynamicResource InfoTexto}" />
                                        <TextBlock x:Name="TituloPedidoKdrop" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Texto}" />
                                        <TextBlock x:Name="DetalhePedidoKdrop" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34"
                                                   Foreground="{DynamicResource TextoFraco}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox x:Name="LembrarPedidoKdrop" Style="{StaticResource CaixaDeSelecao}"
                                              VerticalAlignment="Center" Focusable="False" />
                                    <TextBlock Text="Aceitar sozinho deste aparelho da próxima vez" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{DynamicResource Icone}" VerticalAlignment="Center" />
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <Button Style="{StaticResource BotaoLargo}" Height="40" Margin="0,0,5,0"
                                            Content="Recusar" Click="RecusarKdrop_Click" />
                                    <Button Style="{StaticResource BotaoPrincipalIlha}" Height="40" Margin="5,0,0,0"
                                            Content="Aceitar" Click="AceitarKdrop_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DicaBandeja" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoFraco}"
                                   Text="Arraste arquivos até a Kisland para deixá-los aqui, à mão." />
                        <UniformGrid x:Name="GradeBandeja" Columns="6" Margin="0,8,0,0" />

                        <!--
                            Kdrop: os aparelhos da casa em círculos, como no
                            AirDrop. Toque manda a bandeja inteira; arrastar um
                            arquivo até um deles manda só aquele. O último,
                            "Celular", mostra o QR Code ali mesmo.
                        -->
                        <StackPanel x:Name="AreaKdrop" Visibility="Collapsed">
                            <Border Height="1" Margin="0,10,0,10" Background="{DynamicResource Borda}" />
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,15 L12,3 M7,8 L12,3 L17,8 M4,14 L4,18 A2,2 0 0,0 6,20 L18,20 A2,2 0 0,0 20,18 L20,14"
                                      Stroke="{DynamicResource Acento}" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Kdrop" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Texto}" />
                                <TextBlock x:Name="DicaKdrop" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextoFraco}"
                                           Text="· toque para mandar tudo, ou arraste um arquivo até o aparelho" />
                            </StackPanel>
                            <WrapPanel x:Name="AparelhosKdrop" Margin="0,8,0,0" />
                            <TextBlock x:Name="MotivoKdrop" Visibility="Collapsed" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AvisoIcone}" />

                            <!--
                                O que os outros PCs da casa puseram na bandeja
                                deles: chega junto com o anúncio de cada um.
                                Toque traz para a pasta do Kdrop e para esta
                                bandeja, sem pedido de aceite.
                            -->
                            <StackPanel x:Name="BandejasDeFora" Visibility="Collapsed" />

                            <Border x:Name="QrKdrop" Visibility="Collapsed" Margin="0,8,0,0" CornerRadius="12" Padding="10"
                                    Background="{DynamicResource Fundo}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="White" CornerRadius="10" Padding="8" VerticalAlignment="Center">
                                        <Image x:Name="ImagemQrKdrop" Width="116" Height="116"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Aponte a câmera do celular" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Texto}" />
                                        <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"
                                                   Text="Abre esta bandeja no navegador do celular, na mesma rede Wi-Fi. Ou digite:" />
                                        <TextBlock x:Name="EnderecoKdrop" FontSize="13" FontWeight="Medium" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource Acento}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rodapé -->
                <Grid x:Name="BlocoRodape" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12,3 L20,6 L20,12 C20,17 16.5,20 12,21 C7.5,20 4,17 4,12 L4,6 Z"
                              Stroke="{DynamicResource Acento}" StrokeThickness="2"
                              Width="14" Height="14" Stretch="Uniform" />
                        <TextBlock x:Name="Rodape" Text="KInfo" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Icone}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BotaoRedondoPequeno}" ToolTip="Abrir o painel completo"
                                Click="AbrirPainel_Click">
                            <Path Data="M14,4 L20,4 L20,10 M10,14 L20,4 M19,14 L19,19 A1,1 0 0,1 18,20 L5,20 A1,1 0 0,1 4,19 L4,6 A1,1 0 0,1 5,5 L10,5"
                                  Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource BotaoRedondoPequeno}" ToolTip="Personalização" Margin="8,0,0,0"
                                Click="Personalizar_Click">
                            <Path Data="M12,3 A9,9 0 1,0 12,21 A2,2 0 0,0 14,19 C14,18 13,17.5 13,16.5 C13,15.5 13.7,15 15,15 L17,15 A3,3 0 0,0 20,12 C20,7 16,3 12,3 Z"
                                  Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </Grid>
    </Border>
</Window>
