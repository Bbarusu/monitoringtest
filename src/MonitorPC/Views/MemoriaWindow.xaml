<Window x:Class="MonitorPC.Views.MemoriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memória"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="#C4CAD6" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Memória por programa" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock x:Name="Subtitulo" FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <Border Margin="0,20,0,0" CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,6">
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Lista" />
                </ScrollViewer>
            </Border>

            <Border Margin="0,16,0,0" CornerRadius="12" Background="#2A1A10"
                    BorderBrush="#7C3A14" BorderThickness="1" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12,3 L22,21 L2,21 Z M12,10 L12,15 M12,18 L12,18.01"
                          Stroke="#FB923C" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top"
                          Margin="0,2,10,0" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" MaxWidth="330"
                               Foreground="{DynamicResource AlertaTexto}"
                               Text="Fechar um programa pode perder trabalho não salvo. O pedido é o mesmo do botão X da janela, mas confira antes o que está aberto. Faça por sua conta e risco." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="Rodape" FontSize="11" Margin="0,10,0,0" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="Processos do Windows e de segurança aparecem marcados e não podem ser fechados daqui." />

        </StackPanel>
    </Border>
</Window>
