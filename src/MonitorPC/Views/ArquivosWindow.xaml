<Window x:Class="MonitorPC.Views.ArquivosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arquivos abertos"
        Width="432" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource FonteUI}">

    <Border x:Name="Painel" Margin="20" CornerRadius="16"
            Background="{DynamicResource Fundo}"
            BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoIcone}" ToolTip="Voltar"
                        Margin="0,0,12,0" Click="Voltar_Click">
                    <Path Data="M15,6 L9,12 L15,18" Stroke="{DynamicResource Icone}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Titulo" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto}" />
                    <TextBlock x:Name="Subtitulo" FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextoFraco}" />
                </StackPanel>
            </StackPanel>

            <Grid Margin="2,20,2,6">
                <TextBlock x:Name="Contagem" FontSize="11" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextoMuitoFraco}" />
                <TextBlock Text="clique para abrir a pasta" FontSize="11" HorizontalAlignment="Right"
                           Margin="0,0,10,0" Foreground="{DynamicResource TextoMuitoFraco}" />
            </Grid>

            <Border CornerRadius="12" Background="{DynamicResource Cartao}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" Padding="12,4,6,4">
                <Grid>
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                  PanningMode="VerticalOnly">
                        <StackPanel x:Name="Lista" Margin="0,0,6,0" />
                    </ScrollViewer>
                    <TextBlock x:Name="Vazio" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="12,24,12,24"
                               Foreground="{DynamicResource TextoMuitoFraco}" />
                </Grid>
            </Border>

            <UniformGrid Columns="2" Margin="0,16,0,0">
                <Button Style="{StaticResource BotaoLargo}" Margin="0,0,5,0"
                        Content="Atualizar" Click="Atualizar_Click" />
                <Button Style="{StaticResource BotaoLargo}" Margin="5,0,0,0"
                        Content="Fechar" Click="Voltar_Click" />
            </UniformGrid>

            <TextBlock FontSize="11" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextoMuitoFraco}"
                       Text="A lista é de arquivos abertos agora, não do que foi lido ou escrito. A consulta só roda quando você pede." />

        </StackPanel>
    </Border>
</Window>
