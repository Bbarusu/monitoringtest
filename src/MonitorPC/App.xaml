<Application x:Class="MonitorPC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- Paleta do painel. O acento vem da configuracao em tempo de execucao. -->
        <Color x:Key="FundoColor">#15171C</Color>
        <Color x:Key="AcentoColor">#3B82F6</Color>

        <SolidColorBrush x:Key="Fundo" Color="{StaticResource FundoColor}" />
        <SolidColorBrush x:Key="Borda" Color="#262A32" />
        <SolidColorBrush x:Key="Cartao" Color="#1A1D23" />
        <SolidColorBrush x:Key="Chip" Color="#1D2026" />
        <SolidColorBrush x:Key="Trilho" Color="#2A2E36" />
        <SolidColorBrush x:Key="Texto" Color="#E6E9EF" />
        <SolidColorBrush x:Key="TextoFraco" Color="#9AA3B2" />
        <SolidColorBrush x:Key="TextoMuitoFraco" Color="#8B94A3" />
        <SolidColorBrush x:Key="Acento" Color="{StaticResource AcentoColor}" />
        <SolidColorBrush x:Key="Alerta" Color="#F97316" />
        <SolidColorBrush x:Key="AlertaTexto" Color="#FDBA74" />
        <SolidColorBrush x:Key="Icone" Color="#C4CAD6" />
        <SolidColorBrush x:Key="IconeFraco" Color="#8B94A3" />
        <SolidColorBrush x:Key="AvisoFundo" Color="#2A1A10" />
        <SolidColorBrush x:Key="AvisoBorda" Color="#7C3A14" />
        <SolidColorBrush x:Key="AvisoIcone" Color="#FB923C" />
        <SolidColorBrush x:Key="AvisoChip" Color="#3A2113" />
        <SolidColorBrush x:Key="AvisoBotao" Color="#F97316" />
        <SolidColorBrush x:Key="AvisoBotaoTexto" Color="#1A0F08" />
        <SolidColorBrush x:Key="SerieMedida" Color="#8FBAFF" />
        <SolidColorBrush x:Key="SerieEstimada" Color="#4B5365" />
        <SolidColorBrush x:Key="InfoFundo" Color="#16233D" />
        <SolidColorBrush x:Key="InfoTexto" Color="#8FBAFF" />

        <FontFamily x:Key="FonteUI">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="FonteNumero">Segoe UI Light, Segoe UI</FontFamily>

        <!-- Botao de aba -->
        <Style x:Key="Aba" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="10" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Acento}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao de perfil de energia -->
        <Style x:Key="Perfil" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Icone}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="12"
                                Background="{DynamicResource Cartao}"
                                BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource InfoFundo}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                <Setter Property="Foreground" Value="{DynamicResource InfoTexto}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao redondo do cabecalho -->
        <Style x:Key="BotaoRedondo" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="22" Background="{DynamicResource Acento}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu do icone da bandeja -->
        <Style x:Key="MenuDaBandeja" TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource FonteUI}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="12" Padding="4" Background="{DynamicResource Cartao}"
                                BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                                  Opacity="0.32" Color="Black" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemDoMenu" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg" CornerRadius="8" Padding="12,8" Background="Transparent">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource Trilho}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha de lista clicavel: sem moldura, so realce ao passar o mouse -->
        <ControlTemplate x:Key="LinhaClicavel" TargetType="Button">
            <Border x:Name="bg" CornerRadius="8" Background="Transparent" Padding="8,6">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Trilho}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Barra de rolagem fina, no tom do painel. O WPF so usa esta se o
             estilo for aplicado por tipo, sem chave. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border CornerRadius="4" Margin="2,0"
                                    Background="{DynamicResource Trilho}" Opacity="0.35" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="polegar" CornerRadius="4" Margin="2,0"
                                                        Background="{DynamicResource TextoMuitoFraco}"
                                                        Opacity="0.55" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="polegar" Property="Opacity"
                                                                Value="0.85" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="polegar" Property="Background"
                                                                Value="{DynamicResource Acento}" />
                                                        <Setter TargetName="polegar" Property="Opacity"
                                                                Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <!-- Os botoes de seta somem: a area clicavel do trilho basta. -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Width" Value="Auto" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seletor compacto, no tom do painel -->
        <Style x:Key="Seletor" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="FontFamily" Value="{StaticResource FonteUI}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                        <Setter Property="FontFamily" Value="{StaticResource FonteUI}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}"
                                            TextElement.Foreground="{TemplateBinding Foreground}"
                                            TextElement.FontFamily="{StaticResource FonteUI}"
                                            TextElement.FontSize="12">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource Trilho}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource Acento}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="alternar" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bg" CornerRadius="10" Padding="10,0"
                                                Background="{DynamicResource Chip}"
                                                BorderBrush="{DynamicResource Trilho}" BorderThickness="1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{DynamicResource Trilho}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <!-- O ContentPresenter nao herda a formatacao do ComboBox:
                                     sem isto o texto sai preto e na fonte padrao. -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            TextElement.Foreground="{DynamicResource Texto}"
                                            TextElement.FontFamily="{StaticResource FonteUI}"
                                            TextElement.FontSize="12"
                                            TextElement.FontWeight="Medium">
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      VerticalAlignment="Center" />
                                    <Path Data="M6,9 L12,15 L18,9" Stroke="{DynamicResource IconeFraco}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="11" Height="11" Stretch="Uniform" Margin="8,1,0,0" />
                                </StackPanel>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                                   VerticalOffset="4">
                                <Border Background="{DynamicResource Cartao}" CornerRadius="12" Padding="4"
                                        BorderBrush="{DynamicResource Borda}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                                          Opacity="0.32" Color="Black" />
                                    </Border.Effect>
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interruptor -->
        <Style x:Key="Interruptor" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="trilho" Width="40" Height="22" CornerRadius="11"
                                Background="{DynamicResource Trilho}">
                            <Ellipse x:Name="bolinha" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="trilho" Property="Background" Value="{DynamicResource Acento}" />
                                <Setter TargetName="bolinha" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="bolinha" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="trilho" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Caixa de selecao compacta, para listas. O Interruptor tem 22 px de
            altura e um rotulo ao lado; numa lista de oito ventoinhas isso vira
            uma tela inteira de chaves. Aqui a linha toda e clicavel, e a caixa
            so marca o estado.
        -->
        <Style x:Key="CaixaDeSelecao" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="caixa" Width="20" Height="20" CornerRadius="6"
                                Background="{DynamicResource Chip}"
                                BorderBrush="{DynamicResource Trilho}" BorderThickness="1">
                            <Path x:Name="marca" Data="M5,12 L10,17 L19,7" Visibility="Collapsed"
                                  Stroke="White" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="caixa" Property="Background" Value="{DynamicResource Acento}" />
                                <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                <Setter TargetName="marca" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="caixa" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Amostra de cor -->
        <Style x:Key="Amostra" TargetType="RadioButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="aro" CornerRadius="22" Padding="3"
                                BorderThickness="2" BorderBrush="Transparent">
                            <Ellipse Fill="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="aro" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="aro" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Barras de ajuste (limites, opacidade, tamanho, volume): trilho fino
            de 6 px, a parte cheia na cor de destaque e uma bolinha branca, o
            mesmo desenho da Kisland. Sem chave, vale para todo Slider do app;
            o padrão do Windows, de trilho grosso e marcador quadrado, destoava.
        -->
        <Style x:Key="TrechoCheioAjuste" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource Acento}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrechoVazioAjuste" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BolinhaAjuste" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="Black" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="raiz" Height="20" Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource Trilho}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrechoCheioAjuste}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrechoVazioAjuste}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource BolinhaAjuste}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="raiz" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao de acao secundaria, largura cheia -->
        <Style x:Key="BotaoLargo" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="{DynamicResource Icone}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12" Background="{DynamicResource Cartao}"
                                BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Trilho}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao redondo discreto, para acoes secundarias do cabecalho -->
        <Style x:Key="BotaoRedondoFraco" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="22" Background="{DynamicResource Chip}"
                                BorderBrush="{DynamicResource Trilho}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Trilho}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao quadrado do rodape -->
        <Style x:Key="BotaoIcone" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Background="{DynamicResource Chip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Trilho}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
