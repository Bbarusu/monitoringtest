<Application x:Class="MonitorPC.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="SetupWindow.xaml">
    <Application.Resources>

        <!--
            A paleta escura do painel, repetida aqui. O instalador nao
            referencia o projeto do app de proposito: ele precisa compilar e
            rodar sozinho, e amarrar os dois faria uma mudanca na interface do
            app quebrar o instalador.
        -->
        <SolidColorBrush x:Key="Fundo" Color="#15171C" />
        <SolidColorBrush x:Key="Borda" Color="#262A32" />
        <SolidColorBrush x:Key="Cartao" Color="#1A1D23" />
        <SolidColorBrush x:Key="Chip" Color="#1D2026" />
        <SolidColorBrush x:Key="Trilho" Color="#2A2E36" />
        <SolidColorBrush x:Key="Texto" Color="#E6E9EF" />
        <SolidColorBrush x:Key="TextoFraco" Color="#9AA3B2" />
        <SolidColorBrush x:Key="TextoMuitoFraco" Color="#8B94A3" />
        <SolidColorBrush x:Key="Icone" Color="#C4CAD6" />
        <SolidColorBrush x:Key="Acento" Color="#3B82F6" />
        <SolidColorBrush x:Key="AvisoFundo" Color="#2A1A10" />
        <SolidColorBrush x:Key="AvisoBorda" Color="#7C3A14" />
        <SolidColorBrush x:Key="AvisoIcone" Color="#FB923C" />
        <SolidColorBrush x:Key="AlertaTexto" Color="#FDBA74" />
        <SolidColorBrush x:Key="Sucesso" Color="#4ADE80" />

        <FontFamily x:Key="FonteUI">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- Botao principal, no acento -->
        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12" Background="{DynamicResource Acento}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao secundario, do mesmo formato do BotaoLargo do app -->
        <Style x:Key="BotaoSecundario" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Icone}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12"
                                Background="{DynamicResource Cartao}"
                                BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Trilho}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caixa de selecao, igual a da tela de ajustes do app -->
        <Style x:Key="CaixaDeSelecao" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="caixa" Width="20" Height="20" CornerRadius="6"
                                Background="{DynamicResource Chip}"
                                BorderBrush="{DynamicResource Trilho}" BorderThickness="1">
                            <Path x:Name="marca" Data="M5,12 L10,17 L19,7" Visibility="Collapsed"
                                  Stroke="White" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="caixa" Property="Background" Value="{DynamicResource Acento}" />
                                <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                <Setter TargetName="marca" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="caixa" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
